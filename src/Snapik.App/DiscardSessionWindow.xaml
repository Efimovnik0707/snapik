<!-- Not themed this round: this window is on screen for seconds and its colours are written
     down here on purpose. The base Window style now paints by the palette of the theme, so
     the dark values are pinned here rather than inherited. -->
<Window x:Class="Snapik.App.DiscardSessionWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Snapik.App" xmlns:controls="clr-namespace:Snapik.App.Controls"
 Title="Snapik" Width="430" SizeToContent="Height" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Foreground="#EEF2F8"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <Window.Resources>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EEF2F8"/></Style>
 </Window.Resources>
 <Border Background="#171B22" BorderBrush="#354052" BorderThickness="1" CornerRadius="16" Padding="24">
  <StackPanel>
   <Grid Background="Transparent" MouseLeftButtonDown="OnHeaderDrag">
    <TextBlock Text="Удалить снимки сессии?" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
   </Grid>
   <TextBlock Text="Снимки этой сессии будут удалены. Чтобы сохранить, нажмите «Сохранить пакет…» в меню •••" Foreground="#9AA6B6" TextWrapping="Wrap" Margin="0,14,0,0"/>
   <CheckBox x:Name="DoNotAskBox" Content="Больше не спрашивать" Margin="0,18,0,0"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
    <Button Style="{StaticResource BaseButton}" controls:ButtonChrome.HoverBackground="#2A3240" controls:ButtonChrome.PressedBackground="#20262F" Foreground="White" Margin="0,0,8,0" IsCancel="True" Content="Отмена"/>
    <!-- Deleting is what the exit and the "Clear the strip" command were asked for, so it is the
         default button; Esc and the cancel button leave the captures where they are. -->
    <Button x:Name="DiscardButton" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnDiscard" Content="Удалить"/>
   </StackPanel>
  </StackPanel>
 </Border>
</Window>
