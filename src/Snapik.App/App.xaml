<Application x:Class="Snapik.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/SnapikTheme.xaml" />
                <!-- The palette of the theme, and after it the accent: ThemeService replaces both at
                     startup and on save, each in the slot it is merged into here. -->
                <ResourceDictionary Source="Themes/Palettes/Dark.xaml" />
                <ResourceDictionary Source="Themes/Accents/Blue.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
