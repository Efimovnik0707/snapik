<Application x:Class="Snapik.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/SnapikTheme.xaml" />
                <!-- The palette of the theme, and after it the accent: ThemeService replaces both at
                     startup and on save, each in the slot it is merged into here. -->
                <ResourceDictionary Source="Themes/Palettes/Dark.xaml" />
                <ResourceDictionary Source="Themes/Accents/Blue.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- The family the icons of the chrome are drawn with. Windows 11 ships Segoe Fluent
                 Icons and Windows 10 ships Segoe MDL2 Assets; WPF falls through to the next family
                 glyph by glyph, so one declaration covers both. It stands outside the merged
                 dictionaries because those are swapped whole by ThemeService, and a font is not
                 part of a theme. -->
            <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
