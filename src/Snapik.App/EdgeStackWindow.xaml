<Window x:Class="Snapik.App.EdgeStackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Snapik.App"
        Title="{local:UiText Snapik — Лента снимков}" AutomationProperties.Name="{local:UiText Snapik — Лента снимков}"
        Width="244" MinHeight="128" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        BorderThickness="0" BorderBrush="Transparent" ShowInTaskbar="False" ShowActivated="False" Topmost="False" WindowStartupLocation="Manual">
    <Window.Resources>
        <Style x:Key="StackButton" TargetType="Button">
            <Setter Property="Height" Value="36" /><Setter Property="Padding" Value="10,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="Background" Value="{DynamicResource ElevatedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="B" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource HoverBrush}" /><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource ElevatedLineBrush}" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource FocusBrush}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <!-- The icons of the header: the default WPF template lit them with a pale plate and left the
             icon itself grey, so hovering read as fading. Every icon below binds its Foreground to
             the Foreground of its own button, so one trigger repaints the plate and the icon
             together. They are glyphs of the system font (IconFont) rather than drawings of our
             own: the drawn ones were a shape or two away from the ones Windows shows everywhere. -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="22" /><Setter Property="Height" Value="22" /><Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PressedBrush}" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FocusBrush}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <!-- The close of a card: round and 24 px, and it lies on a photograph, so it carries a dark
             plate of its own. A style of its own rather than BasedOn: CornerRadius lives inside the
             template, and inheritance cannot reach it. -->
        <Style x:Key="CardCloseButton" TargetType="Button">
            <Setter Property="Width" Value="24" /><Setter Property="Height" Value="24" /><Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#CC0F1218" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#D9DEE8" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#E62A313C" /><Setter Property="Foreground" Value="White" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#E6222932" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FocusBrush}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceLineBrush}" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,7" />
            <!-- The column of the check is the reason this template exists in two parts: the previous
                 one carried a single ContentPresenter, so a checkable item ("Always on top", the
                 recipients) was checked in the code and showed nothing of it. -->
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
                <Border x:Name="MenuRow" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Path x:Name="CheckMark" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Left" Width="11" Height="8" Stretch="Uniform"
                              Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M1,4.5 L4,7.5 L10,1.5" />
                        <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" />
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckMark" Property="Visibility" Value="Visible" /></Trigger>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuRow" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="MenuRow" Property="Opacity" Value="0.45" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger></Style.Triggers>
        </Style>
        <!-- The bar carries neither width nor margin of its own any more: both of them belong to the
             template of the ScrollViewer below, which lays the bar over the cards instead of beside
             them. A bar that lives in a column of its own takes its width away from the cards the
             moment the strip overflows, and the cards visibly narrow. -->
        <Style x:Key="StackScrollBar" TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" /></Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Grip" Background="{DynamicResource ScrollThumbBrush}" CornerRadius="2" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" /></Trigger>
                                                    <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource FocusBrush}" /></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" /></Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
    <!-- The margin is the field the shadow of the window needs: a blur of 24 and a depth of 5 want
         12 + 5 px, and ten of them cut the shadow off at the edge of the window. It is the same 20
         the capsule and the grips keep, and it is StripResizeGeometry.ShadowMargin. -->
    <Border x:Name="Shell" Margin="20" Padding="10" CornerRadius="16" Background="{DynamicResource SurfaceBrush}" MouseLeftButtonDown="OnShellMouseDown">
        <Border.Effect><DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="24" ShadowDepth="5" Opacity="{DynamicResource ShadowOpacity}" /></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Grid.Row="0" Height="28" Background="Transparent">
                <!-- Four columns of 22, the width of the button itself and no gap between them:
                     four times thirty took 120 of the 184 the panel has, and "Snapik 26" did not fit
                     in what was left. Eighty-eight now, and 96 for the title. -->
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="22" /><ColumnDefinition Width="22" /><ColumnDefinition Width="22" /><ColumnDefinition Width="22" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Margin="1,0,7,0" />
                    <TextBlock Foreground="{DynamicResource TextBrush}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="Snapik" />
                    <Border Margin="7,0,0,0" Padding="5,2" CornerRadius="8" Background="{DynamicResource ElevatedBrush}">
                        <TextBlock x:Name="CountText" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Text="0" />
                    </Border>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource IconButton}" Click="OnClearStackClick" ToolTip="Очистить ленту" AutomationProperties.Name="Очистить ленту">
                    <TextBlock FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="&#xE74D;" />
                </Button>
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Click="OnMoreClick" ToolTip="Ещё">
                    <TextBlock FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="&#xE712;" />
                </Button>
                <Button Grid.Column="3" Style="{StaticResource IconButton}" Click="OnCollapseToCapsuleClick" ToolTip="Свернуть в капсулу" AutomationProperties.Name="Свернуть в капсулу">
                    <TextBlock FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="&#xE921;" />
                </Button>
                <Button Grid.Column="4" Style="{StaticResource IconButton}" Click="OnHideClick" ToolTip="Свернуть в трей" AutomationProperties.Name="Свернуть в трей">
                    <TextBlock FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="&#xE8BB;" />
                </Button>
            </Grid>

            <!-- The height is the one the corner grip drags and the settings remember, and it is a
                 height, not a maximum: the window is on SizeToContent and has to follow the grip
                 even when the list holds one card. PositionAtEdge sets it for every showing. -->
            <ListBox x:Name="CaptureList" Grid.Row="1" ItemsSource="{Binding Captures}" AllowDrop="True" Height="372" Margin="0,7,0,8" Padding="8,14,8,52"
                     Background="Transparent" BorderThickness="0" SelectionMode="Single" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False"
                     VirtualizingPanel.IsVirtualizing="False"
                     PreviewMouseLeftButtonDown="OnCaptureListMouseDown" PreviewMouseMove="OnCaptureListMouseMove"
                     PreviewMouseWheel="OnCaptureListMouseWheel" Drop="OnCaptureListDrop">
                <ListBox.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource StackScrollBar}" />
                    <!-- The bar lies over the cards, not beside them: the presenter and the bar share one
                         cell of the Grid, so the width the cards are given never changes when the strip
                         starts to overflow. The room for the bar is the right padding of the list,
                         eight pixels the card never reaches, whether the bar is there or not.
                         The name PART_VerticalScrollBar is what makes the wheel and the drag of the grip
                         work without a line of code: ScrollViewer looks the bar up by that name and
                         subscribes to its Scroll itself. -->
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollViewer">
                                    <Grid Background="Transparent">
                                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}"
                                                                CanContentScroll="{TemplateBinding CanContentScroll}"
                                                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                                        <!-- Four pixels, and four whatever the pointer is over: the bar used to
                                             breathe out to six on any hover of the list, and a bar that changes
                                             width under the pointer reads as the list moving. The grip fills the
                                             bar, so the width of the bar is the width of the grip; the hover of
                                             the grip itself is a colour, and it lives in the thumb above. -->
                                        <ScrollBar x:Name="PART_VerticalScrollBar" Orientation="Vertical" HorizontalAlignment="Right"
                                                   Width="4" Margin="0,2,1,2"
                                                   Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}"
                                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.Resources>
                <!-- A plain StackPanel, and the list is not virtualized: twenty-six cards are nothing to
                     save on, while recycling containers handed a card the index and the animated margin
                     of the card before it. The order of the children is the order of the captures, and
                     the last child is drawn over the ones before it: the newest capture lies on top,
                     with no depth to compute and no converter to keep in step. -->
                <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" />
                        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="ThumbCard" Margin="0,0,0,-48" Height="78" CornerRadius="11" Background="#242A33"
                                    BorderBrush="#46505E" BorderThickness="1" ClipToBounds="True" MouseEnter="OnCaptureThumbMouseEnter">
                                <!-- The shadow goes up (Direction 90 in WPF), onto the card above: the cards
                                     overlap by 48 px and the newer one is drawn over the older one, so the
                                     visible seam is the top edge of the card and the shadow falls into it. -->
                                <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="6" Opacity="0.35" Direction="90" /></Border.Effect>
                                <Grid>
                                    <Button x:Name="ThumbContent" Padding="0" Background="Transparent" BorderThickness="0" Click="OnOpenCaptureClick" Tag="{Binding}" ToolTip="Открыть снимок">
                                        <Grid>
                                            <Image x:Name="ThumbImage" Source="{Binding Image}" Stretch="UniformToFill" Opacity="0.86" />
                                            <!-- The letter and the notes stand at the top of the card: the card
                                                 below shows its upper 30 px and nothing else, and that strip has
                                                 to be the one that says which capture it is. The corners are cut
                                                 by ClipToBounds of the card itself. -->
                                            <Border VerticalAlignment="Top" Height="26" Background="#E6171A20">
                                                <Grid Margin="7,0">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <Border x:Name="LabelBadge" Width="20" Height="20" CornerRadius="10" Background="{DynamicResource AccentBrush}">
                                                            <Grid>
                                                                <TextBlock x:Name="LabelText" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="11" FontWeight="Bold" Text="{Binding DisplayLabel}" />
                                                                <Path x:Name="SentMark" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Width="11" Height="8" Stretch="Uniform"
                                                                      Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M1,4.5 L4,7.5 L10,1.5" />
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock Margin="7,0,4,0" VerticalAlignment="Center" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="#AEB8C7" Text="&#xE90A;" />
                                                    <TextBlock VerticalAlignment="Center" Foreground="#DCE3ED" FontSize="11" Text="{Binding NoteCount}" />
                                                    </StackPanel>
                                                    <!-- The kind of the capture, at the right end of the same bar: a
                                                         region says nothing, and the two that are not a region each
                                                         carry a chip of their own. Two chips rather than one with the
                                                         word swapped by a trigger: the language pass writes the text
                                                         of a TextBlock locally, and a local value outlives a setter. -->
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Border x:Name="ScreenChip" Visibility="Collapsed" Height="16" CornerRadius="8" Padding="6,0" Background="#1FFFFFFF">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="#DCE3ED" Text="&#xE7F4;" />
                                                                <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="#DCE3ED" Text="экран" />
                                                            </StackPanel>
                                                        </Border>
                                                        <Border x:Name="ImportChip" Visibility="Collapsed" Height="16" CornerRadius="8" Padding="6,0" Background="#1FFFFFFF">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="#DCE3ED" Text="&#xE7C3;" />
                                                                <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="#DCE3ED" Text="импорт" />
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="DeleteButton" Style="{StaticResource CardCloseButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0" Opacity="0" Click="OnRemoveCaptureClick" Tag="{Binding}" ToolTip="Удалить">
                                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M1,1 L9,9 M9,1 L1,9" />
                                    </Button>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <!-- Sent captures stay in the strip, dimmed and with a check instead of a letter; hover and
                                     selection are declared after this trigger so they still light the card up. The dimming
                                     sits on the thumbnail and its badge, not on the card, so the delete button that appears
                                     on hover stays as bright as on any other capture. -->
                                <DataTrigger Binding="{Binding IsSent}" Value="True">
                                    <Setter TargetName="ThumbContent" Property="Opacity" Value="0.45" />
                                    <Setter TargetName="ThumbCard" Property="BorderBrush" Value="#333C49" />
                                    <Setter TargetName="LabelBadge" Property="Background" Value="#4A5563" />
                                    <Setter TargetName="LabelText" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="SentMark" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <!-- A capture of the whole screen is wider than any card: UniformToFill would
                                     cut a picture of two monitors down to its middle, and the point of that
                                     card is that both of them are on it. -->
                                <DataTrigger Binding="{Binding Kind}" Value="Fullscreen">
                                    <Setter TargetName="ScreenChip" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="ThumbImage" Property="Stretch" Value="Uniform" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Import">
                                    <Setter TargetName="ImportChip" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <!-- The three triggers below move the card by a setter and not by an animation
                                     on purpose: an animation holds its value above every setter of every
                                     trigger for good (FillBehavior.HoldEnd), so after the first hover neither
                                     the keyboard focus nor the selection could move the card any more. Four
                                     pixels without an animation are not worth a second level of priority. -->
                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=ThumbCard}" Value="True">
                                    <Setter TargetName="ThumbCard" Property="BorderBrush" Value="#718096" />
                                    <Setter TargetName="DeleteButton" Property="Opacity" Value="1" />
                                    <Setter TargetName="ThumbCard" Property="Margin" Value="0,4,0,4" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=ThumbCard}" Value="True">
                                    <Setter TargetName="ThumbCard" Property="Margin" Value="0,4,0,4" />
                                    <Setter TargetName="DeleteButton" Property="Opacity" Value="1" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="ThumbCard" Property="Margin" Value="0,4,0,4" />
                                    <Setter TargetName="ThumbCard" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
            </ListBox>

            <!-- An empty strip is a small strip: the list reserves its 372 px even with nothing in
                 it, and a window that tall with a hint in the middle of it reads as a window that
                 failed to restore the session. The two swap places, so the height of the window is
                 the height of its content; the first capture unfolds the list to the height the
                 settings remember, because PositionAtEdge writes it whether the list is shown or
                 not. The corner grip goes with the list: an empty strip has nothing to stretch. -->
            <Border x:Name="EmptyHint" Grid.Row="1" Height="92" Margin="0,7,0,8" Visibility="Collapsed">
                <TextBlock x:Name="EmptyHintText" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="10,0"
                           FontSize="12" LineHeight="17" Foreground="{DynamicResource TextMutedBrush}" />
            </Border>

            <Button Grid.Row="2" Style="{StaticResource StackButton}" Foreground="White" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}" Click="OnCaptureClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,7,0" VerticalAlignment="Center" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="White" Text="&#xE722;" />
                    <TextBlock Text="Новый снимок" FontWeight="SemiBold" />
                </StackPanel>
            </Button>

            <Grid Grid.Row="3" Margin="0" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                <Button x:Name="TargetButton" Height="36" Style="{StaticResource StackButton}" HorizontalContentAlignment="Left" Click="OnTargetClick" ToolTip="Получатель">
                    <DockPanel LastChildFill="True">
                        <Ellipse DockPanel.Dock="Left" Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0" />
                        <Path DockPanel.Dock="Right" Width="8" Height="5" Margin="8,0,0,0" Fill="{DynamicResource TextMutedBrush}" Data="M0,0 L4,4 L8,0 Z" />
                        <TextBlock x:Name="TargetCaption" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Button>
                <Button x:Name="PasteButton" Grid.Column="1" Margin="5,0,0,0" Style="{StaticResource StackButton}" Padding="9" Click="OnPasteClick" IsEnabled="False" ToolTip="Подготовить и вставить в черновик">
                    <Path Width="14" Height="14" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M7,13 L7,1 M2,6 L7,1 L12,6" />
                </Button>
            </Grid>
            <!-- One toast at a time: it fades in over the strip footer, carries an optional action and never takes focus. -->
            <Border x:Name="Toast" Grid.Row="4" Margin="2,8,2,0" Padding="8,5" CornerRadius="8" Background="{DynamicResource ElevatedBrush}" Visibility="Collapsed" Opacity="0">
                <DockPanel LastChildFill="True">
                    <Button x:Name="ToastAction" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="0" VerticalAlignment="Center" Focusable="False"
                            Visibility="Collapsed" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AccentTextBrush}" FontSize="11" Cursor="Hand" Click="OnToastActionClick" />
                    <TextBlock x:Name="ToastText" Foreground="{DynamicResource TextBrush}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <Grid Grid.Row="5" Margin="2,8,2,0">
                <TextBlock x:Name="StatusText" Visibility="Collapsed" Foreground="{DynamicResource DangerBrush}" FontSize="11" TextWrapping="Wrap" />
            </Grid>
        </Grid>
    </Border>
    <!-- The strip collapsed: the same window, not a second one. The window carries the hotkeys, the
         topmost with its suspensions, the tray icon and the drag of the header, and a capsule of
         its own would have to repeat all of it. The margin of 10 is the one the
         shell keeps as well: the margin of 20 carries the shadow. The counter shows what the header shows, the
         captures still waiting. -->
    <Border x:Name="Capsule" Visibility="Collapsed" Margin="20" Height="44" CornerRadius="22" Padding="6,0,12,0"
            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceLineBrush}" BorderThickness="1" Cursor="Hand"
            HorizontalAlignment="Left" VerticalAlignment="Top"
            MouseLeftButtonDown="OnCapsuleClick" ToolTip="Развернуть ленту" AutomationProperties.Name="Развернуть ленту">
        <Border.Effect><DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="18" ShadowDepth="4" Opacity="{DynamicResource ShadowOpacity}" /></Border.Effect>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AccentBrush}">
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="White" Text="&#xE722;" />
            </Border>
            <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" FontSize="12" FontWeight="SemiBold" Text="Новый снимок" />
            <Border Margin="7,0,0,0" Padding="6,2" CornerRadius="8" Background="{DynamicResource ElevatedBrush}" VerticalAlignment="Center">
                <TextBlock x:Name="CapsuleCount" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Text="0" />
            </Border>
            <Path Margin="7,0,0,0" VerticalAlignment="Center" Width="12" Height="7" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.4" StrokeLineJoin="Round" Data="M0,6 L6,1 L12,6" />
        </StackPanel>
    </Border>
    <!-- The left edge of the card resizes the strip: six invisible pixels over the border, right
         where the pointer expects them. The right edge is fixed while dragging, so the strip keeps
         its place at the screen edge. The header drag lives further in and never meets this. -->
    <Thumb x:Name="WidthGrip" HorizontalAlignment="Left" Width="6" Margin="20,22,0,22" Cursor="SizeWE"
           DragStarted="OnWidthDragStarted" DragDelta="OnWidthDragDelta" DragCompleted="OnWidthDragCompleted">
        <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent" /></ControlTemplate></Thumb.Template>
    </Thumb>
    <!-- The bottom left corner takes width and height at once. It is declared after WidthGrip so it
         wins the hit test where the two meet, and it sits on the corner of the visible card, which is
         20 px inside the window because that margin carries the shadow. The cursor is SizeNESW: the
         bottom left corner is dragged along the north-east / south-west diagonal. The window has no
         height of its own (SizeToContent), so the drag changes CaptureList.Height instead.
         The window is not resizable by the system, and the strip has no MaxHeight any more: the
         ceiling comes from the working area of the monitor it is on. -->
    <Thumb x:Name="CornerGrip" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="16" Height="16" Margin="20,0,0,20" Cursor="SizeNESW"
           DragStarted="OnCornerDragStarted" DragDelta="OnCornerDragDelta" DragCompleted="OnCornerDragCompleted">
        <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent" /></ControlTemplate></Thumb.Template>
    </Thumb>
    </Grid>
</Window>
