<Window x:Class="Snapik.App.OnboardingWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Snapik.App" xmlns:controls="clr-namespace:Snapik.App.Controls"
 Title="Snapik" Width="620" Height="600" ResizeMode="CanMinimize" WindowStyle="None" AllowsTransparency="False" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}"
 WindowStartupLocation="Manual" ShowInTaskbar="True" Topmost="False">
 <!-- The window keeps its own header (a name, "minimize" and a cross), so the system chrome is off;
      transparency is off with it: WindowChrome, hardware acceleration and the glass theme all need
      an opaque window. The rounded corner is left to the inner border, the outer one to DWM. -->
 <WindowChrome.WindowChrome>
  <WindowChrome CaptionHeight="0" GlassFrameThickness="0" ResizeBorderThickness="0" CornerRadius="0"/>
 </WindowChrome.WindowChrome>
 <Window.Resources>
  <!-- One layout for every step: the same width, the same heading, the same buttons. The styles are
       local to the wizard on purpose - the shared dictionary is the light theme, and this window is dark. -->
  <Style x:Key="StepPanel" TargetType="StackPanel">
   <Setter Property="Width" Value="440"/><Setter Property="HorizontalAlignment" Value="Center"/>
   <Setter Property="VerticalAlignment" Value="Top"/><Setter Property="Margin" Value="0,12,0,0"/>
  </Style>
  <Style x:Key="StepTitle" TargetType="TextBlock">
   <Setter Property="FontSize" Value="24"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="TextWrapping" Value="Wrap"/>
   <Setter Property="LineHeight" Value="30"/><Setter Property="Margin" Value="0,0,0,10"/>
  </Style>
  <Style x:Key="StepSubtitle" TargetType="TextBlock">
   <Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
   <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="21"/><Setter Property="Margin" Value="0,0,0,28"/>
  </Style>
  <!-- "Skip setup" is a way out, not a button: it leaves the wizard where the step number is, so the
       three levels of the window (the window, the step, the way out) never look like one row. -->
  <Style x:Key="StepSkipLink" TargetType="TextBlock">
   <Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <!-- The one colour of the wizard that is not the accent and not the theme: the taskbar icon is
       either there or it is not, and "there" is said in green. -->
  <SolidColorBrush x:Key="PinnedBrush" Color="#28BE80"/>
  <Style x:Key="StepHintNumber" TargetType="TextBlock">
   <Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/><Setter Property="MinWidth" Value="14"/>
  </Style>
  <Style x:Key="StepHintLine" TargetType="TextBlock">
   <Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/><Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <!-- One card per promise of the step: an icon, what it does, and the one control that does it. -->
  <Style x:Key="StepCard" TargetType="Border">
   <Setter Property="Background" Value="{DynamicResource ElevatedBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource ElevatedLineBrush}"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/>
   <Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="0,0,0,12"/>
  </Style>
  <!-- The switch of the startup entry: the same state a checkbox carried, said the way the rest of
       Windows says it. The knob slides rather than jumps, so the change is seen where it happens.
       The knob takes the tone of the text and not white: the track of a switch that is off is a
       faint line under a light theme, and a white knob on it would not be seen at all. -->
  <Style x:Key="WizardToggle" TargetType="ToggleButton">
   <Setter Property="Width" Value="40"/><Setter Property="Height" Value="22"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ToggleButton">
      <Grid Background="Transparent">
       <Border x:Name="Track" CornerRadius="11" Background="{DynamicResource DividerBrush}"/>
       <Border x:Name="Knob" Width="18" Height="18" CornerRadius="9" Background="{DynamicResource TextBrush}" HorizontalAlignment="Left" Margin="2,0,0,0">
        <Border.RenderTransform><TranslateTransform x:Name="KnobMove"/></Border.RenderTransform>
       </Border>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Trigger.EnterActions>
         <BeginStoryboard>
          <Storyboard><DoubleAnimation Storyboard.TargetName="KnobMove" Storyboard.TargetProperty="X" To="18" Duration="0:0:0.12"/></Storyboard>
         </BeginStoryboard>
        </Trigger.EnterActions>
        <Trigger.ExitActions>
         <BeginStoryboard>
          <Storyboard><DoubleAnimation Storyboard.TargetName="KnobMove" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.12"/></Storyboard>
         </BeginStoryboard>
        </Trigger.ExitActions>
       </Trigger>
       <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Track" Property="Opacity" Value="0.45"/>
        <Setter TargetName="Knob" Property="Opacity" Value="0.45"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="WizardButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
   <Setter Property="Height" Value="34"/><Setter Property="MinHeight" Value="34"/><Setter Property="MinWidth" Value="96"/>
   <Setter Property="Padding" Value="14,0"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
   <Setter Property="controls:ButtonChrome.HoverBackground" Value="{DynamicResource HoverBrush}"/>
   <Setter Property="controls:ButtonChrome.PressedBackground" Value="{DynamicResource PressedBrush}"/>
  </Style>
  <Style x:Key="WizardPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
   <Setter Property="Height" Value="34"/><Setter Property="MinHeight" Value="34"/><Setter Property="MinWidth" Value="96"/>
   <Setter Property="Padding" Value="14,0"/><Setter Property="FontSize" Value="13"/>
  </Style>
  <Style x:Key="WizardIconButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
   <Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="MinWidth" Value="28"/>
   <Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="0"/>
   <Setter Property="controls:ButtonChrome.HoverBackground" Value="{DynamicResource HoverBrush}"/>
   <Setter Property="controls:ButtonChrome.PressedBackground" Value="{DynamicResource PressedBrush}"/>
  </Style>
 </Window.Resources>
 <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceLineBrush}" BorderThickness="1" CornerRadius="16" Padding="24,20,24,24">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <!-- The header belongs to the window and to nothing else: the name of the application, "minimize"
        and the cross. It reads as a header, so it is also what the window is dragged by. -->
   <Grid Height="28" Margin="0,0,0,14" Background="Transparent" MouseLeftButtonDown="OnHeaderDrag">
    <TextBlock Text="Snapik" FontSize="12" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
     <Button x:Name="MinimizeButton" Style="{StaticResource WizardIconButton}" Margin="0,0,4,0" VerticalAlignment="Center" Click="OnMinimize" ToolTip="Свернуть" AutomationProperties.Name="{local:UiText Свернуть}">
      <Path Data="M0,1 L10,1" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
     </Button>
     <Button x:Name="SkipButton" Style="{StaticResource WizardIconButton}" VerticalAlignment="Center" Click="OnSkip" ToolTip="Закрыть" AutomationProperties.Name="{local:UiText Закрыть}">
      <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
     </Button>
    </StackPanel>
   </Grid>

   <!-- The steps scroll, the header and the buttons do not: on a 1366x768 screen at 125 % the way
        forward has to stay on screen whatever the step puts above it. -->
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <Grid>
    <StackPanel x:Name="Step1" Style="{StaticResource StepPanel}" Width="520" TextBlock.TextAlignment="Center">
     <!-- The language is asked once, here, and nowhere else: by the second step it is chosen, and a
          switch on every step reads as a setting the wizard keeps asking about. -->
     <Border x:Name="LanguageToggle" CornerRadius="8" Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Padding="2"
             HorizontalAlignment="Center" Margin="0,0,0,22"
             ToolTip="Язык интерфейса" AutomationProperties.Name="{local:UiText Язык интерфейса}">
      <StackPanel Orientation="Horizontal">
       <RadioButton x:Name="RussianSegment" Style="{StaticResource SegmentButton}" GroupName="OnboardingLanguage" Content="Русский"/>
       <RadioButton x:Name="EnglishSegment" Style="{StaticResource SegmentButton}" GroupName="OnboardingLanguage" Content="English"/>
      </StackPanel>
     </Border>
     <TextBlock Text="Выдели. Прокомментируй. Отправь." Style="{StaticResource StepTitle}"/>
     <TextBlock Text="Скриншотер для одной задачи: несколько снимков с заметками — и сразу в дело. В чат с ИИ, в мессенджер, в письмо, в задачу."
                Style="{StaticResource StepSubtitle}" MaxWidth="470" Margin="0,0,0,26"/>
     <!-- The same scene the first slide shows: what the product does, in one loop of nine seconds. -->
     <controls:CaptureSceneSmall x:Name="WelcomeScene" HorizontalAlignment="Center"/>
    </StackPanel>

    <StackPanel x:Name="Step2" Style="{StaticResource StepPanel}" Visibility="Collapsed">
     <TextBlock Text="Клавиша для снимка" Style="{StaticResource StepTitle}"/>
     <TextBlock Text="Нажми на поле и введи своё сочетание" Style="{StaticResource StepSubtitle}"/>
     <controls:HotkeyField x:Name="CaptureField" AutomationProperties.Name="{local:UiText Клавиша для снимка}"/>
     <!-- The rules answer before the registration does: a combination Windows takes first, or the one
          the fullscreen save already holds, is refused here and the step does not let go. -->
     <TextBlock x:Name="CaptureConflictText" FontSize="12" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,10,0,0"/>
     <Border x:Name="SuggestChip" CornerRadius="6" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
             Padding="8,4" HorizontalAlignment="Left" Margin="0,10,0,0" Cursor="Hand" Visibility="Collapsed"
             MouseLeftButtonDown="OnSuggestFreeShortcut">
      <TextBlock x:Name="SuggestChipText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
     </Border>
    </StackPanel>

    <StackPanel x:Name="Step3" Style="{StaticResource StepPanel}" Visibility="Collapsed">
     <TextBlock Text="Чтобы всегда был под рукой" Style="{StaticResource StepTitle}"/>
     <TextBlock Text="Два переключателя — и Snapik не придётся искать." Style="{StaticResource StepSubtitle}"/>
     <Border Style="{StaticResource StepCard}">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}">
        <Path Width="20" Height="20" Stretch="None" Data="M10,2 A8,8 0 1 1 4.3,4.3 M10,2 L10,7 M10,2 L6,4"
              Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
       </Border>
       <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,14,0">
        <TextBlock Text="Открывать при включении компьютера" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
        <TextBlock Text="Ждёт в углу экрана, клавиша работает сразу" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
        <!-- Shown only when the startup entry cannot be read or written: a switch that is grey for no
             visible reason looks like a bug. -->
        <TextBlock x:Name="StartupUnavailableText" Text="Автозапуск недоступен" FontSize="12" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,6,0,0"/>
       </StackPanel>
       <ToggleButton x:Name="StartupBox" Grid.Column="2" Style="{StaticResource WizardToggle}" VerticalAlignment="Center"
                     AutomationProperties.Name="{local:UiText Открывать при включении компьютера}"/>
      </Grid>
     </Border>
     <Border Style="{StaticResource StepCard}">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}">
        <Path Width="18" Height="20" Stretch="Uniform" Fill="{DynamicResource AccentBrush}"
              Data="M3,0 L9,0 L8,1.6 L8,5 L11,7.6 L11,8.8 L6.6,8.8 L6.6,13 L5.4,13 L5.4,8.8 L1,8.8 L1,7.6 L4,5 L4,1.6 Z"/>
       </Border>
       <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,14,0">
        <TextBlock Text="Закрепить на панели задач" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
        <TextBlock x:Name="PinSubtitle" Text="Иконка внизу экрана, клик открывает ленту" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
        <!-- Where the button was, once the button could not do it: the three steps of the manual way.
             Nothing is promised before that, so the button says what it does and nothing more. -->
        <StackPanel x:Name="PinInstructions" Visibility="Collapsed" Margin="0,8,0,0">
         <StackPanel Orientation="Horizontal">
          <TextBlock Text="1." Style="{StaticResource StepHintNumber}"/>
          <TextBlock Text="Открой «Пуск»" Style="{StaticResource StepHintLine}"/>
         </StackPanel>
         <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
          <TextBlock Text="2." Style="{StaticResource StepHintNumber}"/>
          <TextBlock Text="Нажми правой кнопкой на Snapik" Style="{StaticResource StepHintLine}"/>
         </StackPanel>
         <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
          <TextBlock Text="3." Style="{StaticResource StepHintNumber}"/>
          <TextBlock Text="Выбери «Закрепить на панели задач»" Style="{StaticResource StepHintLine}"/>
         </StackPanel>
        </StackPanel>
       </StackPanel>
       <Button x:Name="PinButton" Grid.Column="2" Style="{StaticResource WizardButton}" Height="32" MinHeight="32" MinWidth="0"
               Padding="12,0" VerticalAlignment="Center" Content="Закрепить" Click="OnPinToTaskbar"/>
       <Border x:Name="PinDone" Grid.Column="2" Height="32" CornerRadius="7" Padding="12,0" VerticalAlignment="Center" Visibility="Collapsed"
               Background="#2628BE80" BorderBrush="#28BE80" BorderThickness="1">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
         <Path Width="12" Height="10" Stretch="None" Data="M1,5 L4.5,8.5 L11,1" Stroke="#28BE80" StrokeThickness="2"
               StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center"/>
         <TextBlock Text="Закреплено" FontSize="13" Foreground="#28BE80" VerticalAlignment="Center" Margin="6,0,0,0"/>
        </StackPanel>
       </Border>
      </Grid>
     </Border>
    </StackPanel>

    <StackPanel x:Name="Step4" Style="{StaticResource StepPanel}" Width="520" Visibility="Collapsed">
     <TextBlock Text="Как будет выглядеть" Style="{StaticResource StepTitle}"/>
     <TextBlock Text="Нажми — окно сразу перекрасится. Поменять можно в любой момент в настройках." Style="{StaticResource StepSubtitle}"/>
     <!-- The same control the settings show under "Look": it repaints the application as it is
          clicked and saves nothing; what the wizard takes from it is read when the wizard is done. -->
     <controls:AppearancePicker x:Name="Appearance" HorizontalAlignment="Center"/>
    </StackPanel>

    <StackPanel x:Name="Step5" Style="{StaticResource StepPanel}" Width="480" Margin="0" Visibility="Collapsed">
     <!-- The heading of this step belongs to the slides: it carries the name of the slide under it,
          and the tray opens the same control without the rest of the wizard. -->
     <controls:HowToSlides x:Name="HowTo"/>
    </StackPanel>
   </Grid>
   </ScrollViewer>

   <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,8"/>
   <Grid Grid.Row="3" Margin="0,14,0,0">
    <StackPanel x:Name="StepFooter" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock x:Name="StepText" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
     <TextBlock x:Name="SkipLink" Style="{StaticResource StepSkipLink}" Text="Пропустить настройку" MouseLeftButtonDown="OnSkipLink"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
     <Button x:Name="BackButton" Style="{StaticResource WizardButton}" Margin="0,0,8,0" Content="Назад" Click="OnBack"/>
     <Button x:Name="NextButton" Style="{StaticResource WizardPrimaryButton}" Content="Далее" Click="OnNext"/>
     <Button x:Name="StartButton" Style="{StaticResource WizardPrimaryButton}" Visibility="Collapsed" Content="Начать" Click="OnStart"/>
    </StackPanel>
   </Grid>
  </Grid>
 </Border>
</Window>
