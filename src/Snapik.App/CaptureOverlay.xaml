<!-- Not themed this round: this window is on screen for seconds and its colours are written
     down here on purpose. The base Window style now paints by the palette of the theme, so
     the dark values are pinned here rather than inherited. -->
<Window x:Class="Snapik.App.CaptureOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Foreground="#EEF2F8" ShowInTaskbar="False" Topmost="True"
        Cursor="Cross" KeyDown="OnKeyDown" MouseLeftButtonDown="OnMouseDown"
        MouseMove="OnMouseMove" MouseLeftButtonUp="OnMouseUp">
    <Grid>
        <Image x:Name="DesktopImage" Stretch="Fill" />
        <Path x:Name="Shade" Fill="#880B1020" IsHitTestVisible="False" />
        <Border x:Name="SelectionBorder" Visibility="Collapsed" BorderBrush="White" BorderThickness="1.5"
                Background="#08FFFFFF" IsHitTestVisible="False">
            <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.5" /></Border.Effect>
        </Border>
        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0" Padding="14,9"
                CornerRadius="8" Background="#E6172033" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <TextBlock Foreground="White" FontWeight="SemiBold" Text="Выделите область" />
                <TextBlock Margin="12,0,0,0" Foreground="#C9D1E2" Text="Esc — отменить" />
            </StackPanel>
        </Border>
        <Border x:Name="SizeBadge" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                Padding="7,4" CornerRadius="5" Background="#E6172033" IsHitTestVisible="False">
            <TextBlock x:Name="SizeText" Foreground="White" FontSize="12" FontWeight="SemiBold" />
        </Border>
    </Grid>
</Window>
