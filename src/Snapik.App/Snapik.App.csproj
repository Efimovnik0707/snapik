<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows SDK projection comes with the target framework: pinning the build number is
         what makes Windows.UI.Shell.TaskbarManager resolve. Revision .0, not .1: .1 pulls the
         CsWinRT 3.0 preview along with it. -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <!-- Without this the supported floor rises to 26100 on its own, and Windows 10 falls out. -->
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Snapik.ico</ApplicationIcon>
    <AssemblyName>Snapik</AssemblyName>
    <RootNamespace>Snapik.App</RootNamespace>
    <Version>1.6.0</Version>
    <Product>Snapik</Product>
    <Authors>Nikita Efimov</Authors>
    <Copyright>Copyright (c) 2026 Nikita Efimov</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Snapik.Core\Snapik.Core.csproj" />
    <ProjectReference Include="..\Snapik.Infrastructure\Snapik.Infrastructure.csproj" />
    <ProjectReference Include="..\Snapik.Windows\Snapik.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Content, not EmbeddedResource: MediaPlayer opens files, not pack:// resources. -->
    <Content Include="Assets\Audio\*.mp3" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup><Compile Remove="MainWindow.xaml.cs" /><Page Remove="MainWindow.xaml" /></ItemGroup>
</Project>
