<Window x:Class="Snapik.App.HotkeySettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Snapik.App" xmlns:controls="clr-namespace:Snapik.App.Controls"
 Title="Настройки Snapik" Width="620" Height="620" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Foreground="{DynamicResource TextBrush}"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <!-- The height is the tallest tab ("Вид") and not the shortest: the window neither scrolls nor
      resizes, so a tab that outgrows the number is cut off in silence. VerifyTz007Settings measures
      all four tabs against it, so a row added anywhere either fits or stops the run. -->
 <Window.Resources>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource ElevatedBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource ElevatedLineBrush}"/><Setter Property="Padding" Value="10,7"/></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Tab" Padding="15,9" Margin="0,0,6,12" CornerRadius="8" Background="{DynamicResource ElevatedBrush}"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="Background" Value="{DynamicResource AccentSoftBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceLineBrush}" BorderThickness="1" CornerRadius="16" Padding="24">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,22" Background="Transparent" MouseLeftButtonDown="OnHeaderDrag">
   <TextBlock Text="Настройки" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/>
   <Button x:Name="CloseButton" Style="{StaticResource BaseButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Width="28" Height="28" MinHeight="28" Padding="0" Click="OnClose" ToolTip="Закрыть" AutomationProperties.Name="{local:UiText Закрыть}">
    <Path Data="M0,0 L11,11 M11,0 L0,11" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
   </Button>
  </Grid>
  <TabControl x:Name="Tabs" Grid.Row="1" Background="Transparent" BorderThickness="0">
   <TabItem Header="Общие"><StackPanel Margin="0,10,0,0">
    <!-- The same switch the wizard and the tray carry, over the same registry value; a profile that
         keeps it closed to us says so instead of leaving a box that does nothing. -->
    <StackPanel Margin="0,0,0,16">
     <CheckBox x:Name="StartupBox" Content="Открывать при включении компьютера" Margin="0"/>
     <TextBlock x:Name="StartupUnavailableText" Text="Автозапуск недоступен" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="22,5,0,0" Visibility="Collapsed"/>
    </StackPanel>
    <CheckBox x:Name="NotificationsBox" Content="Показывать уведомления" ToolTip="Всплывающее окно у часов: «Скопировано», «Сохранено»"/>
    <CheckBox x:Name="ClearStackBox" Content="{local:UiText Очищать ленту после вставки}" ToolTip="После Ctrl+V лента очищается сама, снимки удаляются"/>
    <CheckBox x:Name="SoundsBox" Content="{local:UiText Звуки}" Margin="0,0,0,8" ToolTip="Щелчок затвора при снимке и тихие тики ленты"/>
    <StackPanel x:Name="VolumeRow" Margin="22,0,0,16" ToolTip="Насколько громко звучит интерфейс">
     <TextBlock Text="Громкость" Margin="0,0,0,5"/>
     <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Width="200" HorizontalAlignment="Left" AutomationProperties.Name="{local:UiText Громкость}"/>
    </StackPanel>
    <TextBlock Text="Язык" Margin="0,4,0,7"/>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
     <RadioButton x:Name="RussianSegment" Style="{StaticResource SegmentButton}" GroupName="SettingsLanguage" Content="Русский"/>
     <RadioButton x:Name="EnglishSegment" Style="{StaticResource SegmentButton}" GroupName="SettingsLanguage" Content="English"/>
    </StackPanel>
    <!-- The way back into the wizard, which otherwise opens once in the life of the installation.
         It reads as a way out and not as a button, the same as "Skip setup" in the wizard itself. -->
    <TextBlock x:Name="RunOnboardingLink" Text="Пройти знакомство заново" FontSize="12" Foreground="{DynamicResource TextFaintBrush}"
               Cursor="Hand" HorizontalAlignment="Left" Margin="0,18,0,0" MouseLeftButtonDown="OnRunOnboarding"/>
   </StackPanel></TabItem>
   <TabItem Header="Клавиши"><StackPanel Margin="0,10,0,0">
    <CheckBox x:Name="CaptureEnabledBox" Content="Сделать скриншот" Margin="0,0,0,7"/>
    <controls:HotkeyField x:Name="CaptureField" Margin="0,0,0,20" HotkeyChanged="OnHotkeyChanged" AutomationProperties.Name="{local:UiText Сделать скриншот}"/>
    <CheckBox x:Name="FullscreenEnabledBox" Content="Снимок всего экрана" Margin="0,0,0,7"/>
    <controls:HotkeyField x:Name="FullscreenField" HotkeyChanged="OnHotkeyChanged" AutomationProperties.Name="{local:UiText Снимок всего экрана}"/>
    <!-- The shortcut of the whole screen is off until it is asked for, and the chip is the asking:
         it carries the first free combination and switches the shortcut on with it. -->
    <Button x:Name="SuggestChip" Style="{StaticResource BaseButton}" Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource ElevatedLineBrush}"
            HorizontalAlignment="Left" Margin="0,10,0,0" MinHeight="28" Padding="12,4" FontSize="12" Click="OnSuggestShortcut" Visibility="Collapsed"/>
   </StackPanel></TabItem>
   <TabItem Header="Сохранение"><StackPanel Margin="0,10,0,0">
    <CheckBox x:Name="AutoSaveBox" Content="{local:UiText Автоматически сохранять готовые снимки}" Margin="0,0,0,16" ToolTip="Каждый готовый снимок сразу ложится в папку сохранения"/>
    <TextBlock Text="Формат" Margin="0,0,0,7"/>
    <ComboBox x:Name="FormatBox" Width="140" HorizontalAlignment="Left" ToolTip="JPEG легче, PNG точнее"><ComboBoxItem Content="PNG"/><ComboBoxItem Content="JPEG"/></ComboBox>
    <TextBlock x:Name="QualityLabel" Margin="0,14,0,0"/>
    <Slider x:Name="QualitySlider" Minimum="1" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,6,0,16"/>
    <TextBlock Text="Папка сохранения" Margin="0,0,0,7"/>
    <Grid ToolTip="Куда падают снимки и пакеты"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><TextBox x:Name="DirectoryBox"/><Button Grid.Column="1" Style="{StaticResource BaseButton}" Margin="6,0,0,0" Padding="0" Content="…" Click="OnBrowseDirectory" ToolTip="Выбрать папку"/></Grid>
   </StackPanel></TabItem>
   <!-- The same control the wizard shows on its fourth step, with the row of annotation palettes
        the wizard does not show. -->
   <TabItem x:Name="AppearanceTabItem" Header="Вид"><StackPanel Margin="0,10,0,0">
    <controls:AppearancePicker x:Name="AppearanceTab" ShowPaletteRow="True"/>
   </StackPanel></TabItem>
  </TabControl>
  <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,8"/>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
   <Button Style="{StaticResource BaseButton}" Margin="0,0,8,0" IsCancel="True" Content="Отмена"/>
   <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnSave" Content="Сохранить"/>
  </StackPanel>
 </Grid>
 </Border>
</Window>
