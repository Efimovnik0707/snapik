<Window x:Class="Snapik.App.OverlayEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Snapik.App.Controls"
        xmlns:local="clr-namespace:Snapik.App"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="Snapik — Захват и разметка" AutomationProperties.Name="Snapik — Захват и разметка"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False" Background="#0A0D12"
        ShowInTaskbar="False" Topmost="True"
        KeyDown="OnWindowKeyDown" KeyUp="OnWindowKeyUp" MouseLeftButtonDown="OnWindowMouseDown"
        MouseMove="OnWindowMouseMove" MouseLeftButtonUp="OnWindowMouseUp">
    <Window.Resources>
        <!-- The width of the properties block, the same one under every tool: the panel is measured
             before the capture is placed, and a block that changed width with the tool in the hand
             would move the decision "one row or two" with it, and the panel under the pointer. -->
        <sys:Double x:Key="ToolbarPropertiesWidth">176</sys:Double>
        <!-- The face of a region filled with blur: worn by the segment that picks it and by the
             preview on the fill button, so both say the same thing. -->
        <LinearGradientBrush x:Key="BlurFillPreview" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#66D9DEE8" Offset="0" /><GradientStop Color="#14D9DEE8" Offset="0.5" /><GradientStop Color="#66D9DEE8" Offset="1" />
        </LinearGradientBrush>
        <!-- Name plus a key capsule, in the dark of the popover. The letter is carried by Uid of the
             button, filled by the code out of EditorShortcuts, so the panel keeps no letters of its
             own. Uid and not an attached property of ours: a path with a prefix
             ("(local:EditorShortcuts.ShortcutKey)") is resolved by the parser context, which a style
             of a resource dictionary no longer has by the time the tooltip is built, and the capsule
             stays empty without a single line in the binding trace. -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" /><Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Placement" Value="Bottom" /><Setter Property="VerticalOffset" Value="7" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceLineBrush}" BorderThickness="1" CornerRadius="9" Padding="9,6" TextElement.Foreground="{DynamicResource TextBrush}">
                    <StackPanel Orientation="Horizontal">
                        <ContentPresenter VerticalAlignment="Center" />
                        <Border x:Name="KeyCap" Margin="9,0,0,0" Padding="6,1" VerticalAlignment="Center" CornerRadius="5" Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource ElevatedLineBrush}" BorderThickness="1">
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding PlacementTarget.Uid, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Border>
                    </StackPanel>
                </Border>
                <ControlTemplate.Triggers>
                    <DataTrigger Binding="{Binding PlacementTarget.Uid, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                        <Setter TargetName="KeyCap" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding PlacementTarget.Uid, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}">
                        <Setter TargetName="KeyCap" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="OverlayTool" TargetType="ToggleButton">
            <Setter Property="ToolTipService.InitialShowDelay" Value="150" />
            <Setter Property="Width" Value="36" /><Setter Property="Height" Value="36" /><Setter Property="Margin" Value="2,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
                <Border x:Name="B" CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource AccentSoftBrush}" /><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource FocusBrush}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <!-- Split button: one capsule made of the tool itself and a 14 px chevron zone that opens the
             menu of that tool. The halves are rounded outwards only, so they read as one control. -->
        <Style x:Key="OverlayToolStart" TargetType="ToggleButton" BasedOn="{StaticResource OverlayTool}">
            <Setter Property="Width" Value="32" /><Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
                <Border x:Name="B" CornerRadius="9,0,0,9" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource AccentSoftBrush}" /><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource FocusBrush}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="OverlayToolChevron" TargetType="Button">
            <Setter Property="ToolTipService.InitialShowDelay" Value="150" />
            <Setter Property="Width" Value="14" /><Setter Property="MinWidth" Value="14" /><Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,0,2,0" /><Setter Property="Padding" Value="0" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="B" CornerRadius="0,9,9,0" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                    <Path Width="8" Height="5" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M0.5,1 L4,4 L7.5,1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource FocusBrush}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SegmentButton" TargetType="ToggleButton">
            <Setter Property="Height" Value="30" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" /><Setter Property="Margin" Value="1,0" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
                <Border x:Name="B" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource AccentSoftBrush}" /><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource FocusBrush}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="OverlayButton" TargetType="Button">
            <Setter Property="ToolTipService.InitialShowDelay" Value="150" />
            <Setter Property="Height" Value="36" /><Setter Property="MinWidth" Value="36" /><Setter Property="Padding" Value="11,0" />
            <Setter Property="Margin" Value="2,0" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="B" CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource FocusBrush}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="StrokeSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
                <Grid Background="Transparent">
                    <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}">
                        <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" CornerRadius="2" Background="{DynamicResource AccentBrush}"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb Width="16" Height="16"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="{DynamicResource TextBrush}" Stroke="{DynamicResource TextFaintBrush}" StrokeThickness="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" CornerRadius="2" Background="{DynamicResource ElevatedLineBrush}"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
                    </Track>
                </Grid>
                <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="Root">
        <Image x:Name="DesktopImage" Stretch="Fill" />
        <Path x:Name="Shade" Fill="#A20A0D12" IsHitTestVisible="False" />
        <Canvas x:Name="EditorLayer">
            <Border x:Name="CropBorder" Visibility="Collapsed" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" Background="Transparent">
                <controls:AnnotationCanvas x:Name="Surface" ImagePadding="0" Tool="Rectangle"
                                           AnnotationCreated="OnAnnotationCreated" SelectionChanged="OnSelectionChanged"
                                           AnnotationActivated="OnAnnotationActivated"
                                           AnnotationChanged="OnAnnotationChanged" CropRequested="OnCropRequested"
                                           ViewChanged="OnSurfaceViewChanged" NoteHovered="OnSurfaceNoteHovered" />
            </Border>
        </Canvas>
        <Canvas x:Name="CaptureHandleLayer" />
        <!-- Where a caption is typed: a text box standing over the capture, at the point that was
             clicked and in the size of the mark, so what is typed is what will be drawn. -->
        <Canvas x:Name="TextLayer" />
        <Canvas x:Name="ChipLayer" IsHitTestVisible="True" />

        <Border x:Name="Hint" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0" Padding="13,8"
                Background="#E8171A20" CornerRadius="10">
            <TextBlock Foreground="White" FontSize="13" Text="Выделите область · Esc отменяет" />
        </Border>

        <Border x:Name="ShotNoteChip" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Width="250"
                Padding="8" CornerRadius="12" Background="{DynamicResource SurfaceBrush}">
            <StackPanel>
                <Grid>
                    <TextBlock x:Name="ShotLabel" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold" />
                    <Button HorizontalAlignment="Right" Width="25" Height="25" Padding="7" Background="Transparent" BorderThickness="0" Click="OnCloseShotNoteClick" ToolTip="Удалить комментарий">
                        <TextBlock FontFamily="{StaticResource IconFont}" FontSize="11" Text="&#xE8BB;" Foreground="{DynamicResource TextBrush}" />
                    </Button>
                </Grid>
                <TextBox x:Name="ShotNoteBox" Margin="0,5,0,0" MinHeight="34" MaxHeight="92" AcceptsReturn="True" TextWrapping="Wrap"
                         Background="{DynamicResource ElevatedBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource ElevatedLineBrush}" CaretBrush="{DynamicResource TextBrush}" SelectionBrush="{DynamicResource AccentBrush}"
                         TextChanged="OnShotNoteChanged" />
            </StackPanel>
        </Border>

        <!-- What the capture is, in the top right corner of it: the whole screen with the number of
             monitors, or a file that was imported, and the size in pixels either way. A capture of a
             region says nothing, and the caption stays collapsed. -->
        <Border x:Name="ShotKindChip" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                Padding="10,4" CornerRadius="8" Background="#E6171A20" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ShotKindGlyph" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="#DCE3ED" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock x:Name="ShotKindText" FontSize="12" Foreground="#DCE3ED" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- The comments of a capture reopened from the strip, in a strip of its own on the right.
             The capture, the toolbar and the pills are laid out to the left of it. -->
        <Border x:Name="CommentsPanel" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Width="280"
                Padding="14" CornerRadius="16" Background="{DynamicResource SurfaceBrush}">
            <Border.Effect><DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="22" ShadowDepth="5" Opacity="{DynamicResource ShadowOpacity}" /></Border.Effect>
            <DockPanel>
                <TextBlock x:Name="CommentsTitle" DockPanel.Dock="Top" Text="Комментарии" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10" />
                <TextBlock x:Name="CommentsEmpty" DockPanel.Dock="Top" Text="Нет комментариев" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Visibility="Collapsed" />
                <ScrollViewer x:Name="CommentsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="CommentsList" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border x:Name="Toolbar" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                Padding="7" CornerRadius="16" Background="{DynamicResource SurfaceBarBrush}">
            <Border.Effect><DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="22" ShadowDepth="5" Opacity="{DynamicResource ShadowOpacity}" /></Border.Effect>
            <!-- A grid of two rows and four columns, and not a WrapPanel: the panel wraps by meaning
                 and not by the place a button happened to run out of. With room it is one row —
                 tools, properties, free space, buttons on the right; without it the properties move
                 to a second row of their own and the buttons stay where the hand looks for them.
                 Background="Transparent": the background and the gaps take a press and drag the
                 panel, while the buttons take theirs first, the way the strip does it. -->
            <Grid x:Name="ToolbarBody" Background="Transparent" AutomationProperties.Name="{local:UiText Панель разметки}"
                  MouseLeftButtonDown="OnToolbarMouseDown" MouseMove="OnToolbarMouseMove"
                  MouseLeftButtonUp="OnToolbarMouseUp" LostMouseCapture="OnToolbarLostCapture">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />  <!-- 0 tools -->
                    <ColumnDefinition Width="Auto" />  <!-- 1 properties, while they stand in one row -->
                    <ColumnDefinition Width="*" />     <!-- 2 free space, and the handle of the panel -->
                    <ColumnDefinition Width="Auto" />  <!-- 3 the buttons on the right -->
                </Grid.ColumnDefinitions>
            <StackPanel x:Name="ToolbarTools" Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                <ToggleButton x:Name="SelectTool" Style="{StaticResource OverlayTool}" Tag="Select" Click="OnToolClick">
                    <Path Width="16" Height="16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.7" StrokeLineJoin="Round" Data="M2,1 L14,9 L9,10 L7,15 Z" />
                </ToggleButton>
                <ToggleButton x:Name="RectangleTool" IsChecked="True" Style="{StaticResource OverlayToolStart}" Tag="Rectangle" Click="OnToolClick">
                    <Path Width="16" Height="16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.7" Data="M2,3 L14,3 L14,13 L2,13 Z" />
                </ToggleButton>
                <Button x:Name="ShapeMenuButton" Style="{StaticResource OverlayToolChevron}" Click="OnShapeMenuClick" ToolTip="Фигура" AutomationProperties.Name="{local:UiText Фигура}" />
                <ToggleButton x:Name="ArrowTool" Style="{StaticResource OverlayToolStart}" Tag="Arrow" Click="OnToolClick">
                    <Path Width="17" Height="17" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M2,15 L15,2 M9,2 L15,2 L15,8" />
                </ToggleButton>
                <Button x:Name="ArrowMenuButton" Style="{StaticResource OverlayToolChevron}" Click="OnArrowOptionsClick" ToolTip="Стиль стрелки" AutomationProperties.Name="{local:UiText Стиль стрелки}" />
                <!-- One capsule for the pen and the highlighter: the button draws the current mode
                     and carries it in its own Tag, the chevron beside it offers the other one. -->
                <ToggleButton x:Name="PenTool" Style="{StaticResource OverlayToolStart}" Tag="Pen" Click="OnToolClick">
                    <TextBlock x:Name="PencilCapsuleGlyph" FontFamily="{StaticResource IconFont}" FontSize="16" Text="&#xED63;" />
                </ToggleButton>
                <Button x:Name="PenMenuButton" Style="{StaticResource OverlayToolChevron}" Click="OnPencilMenuClick" ToolTip="Карандаш" AutomationProperties.Name="{local:UiText Карандаш}" />
                <ToggleButton x:Name="TextTool" Style="{StaticResource OverlayTool}" Tag="Text" Click="OnToolClick">
                    <TextBlock FontFamily="{StaticResource IconFont}" FontSize="16" Text="&#xE8D2;" />
                </ToggleButton>
                <ToggleButton x:Name="EraserTool" Style="{StaticResource OverlayTool}" Tag="Eraser" Click="OnToolClick">
                    <TextBlock FontFamily="{StaticResource IconFont}" FontSize="16" Text="&#xE75C;" />
                </ToggleButton>
                <ToggleButton x:Name="BlurTool" Style="{StaticResource OverlayTool}" Tag="Blur" Click="OnToolClick">
                    <Path Width="16" Height="16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.4" Data="M2,4 L5,2 L8,4 L11,2 L14,4 M2,8 L5,6 L8,8 L11,6 L14,8 M2,12 L5,10 L8,12 L11,10 L14,12" />
                </ToggleButton>
                <ToggleButton x:Name="CropTool" Style="{StaticResource OverlayTool}" Tag="Crop" Click="OnToolClick">
                    <TextBlock FontFamily="{StaticResource IconFont}" FontSize="16" Text="&#xE7A8;" />
                </ToggleButton>
<!-- A tool like the others, and checked like the others: the comment stays armed until it is
                     put down, so the panel has to show that it is in the hand. -->
                <ToggleButton x:Name="CommentToolButton" Style="{StaticResource OverlayTool}" Tag="Comment" Click="OnCommentClick" AutomationProperties.Name="{local:UiText Комментарий}">
                    <TextBlock FontFamily="{StaticResource IconFont}" FontSize="16" Text="&#xE90A;" />
                </ToggleButton>
                <Button x:Name="ShortcutSheetButton" Style="{StaticResource OverlayButton}" Width="30" MinWidth="30" Padding="0" FontWeight="SemiBold" Content="?" Click="OnShortcutSheetClick" ToolTip="Сочетания клавиш" AutomationProperties.Name="{local:UiText Сочетания клавиш}" />
                <Popup x:Name="ShortcutSheetPopup" PlacementTarget="{Binding ElementName=ShortcutSheetButton}" Placement="Bottom" VerticalOffset="8" AllowsTransparency="True" StaysOpen="False">
                    <Border Padding="18" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceLineBrush}" BorderThickness="1" CornerRadius="14" TextElement.Foreground="{DynamicResource TextBrush}" Cursor="Arrow">
                        <StackPanel>
                            <TextBlock Text="Сочетания клавиш" FontWeight="SemiBold" Margin="0,0,0,13" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="34" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel x:Name="SheetTools"><TextBlock Text="Инструменты" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,7" /></StackPanel>
                                <StackPanel x:Name="SheetActions" Grid.Column="2"><TextBlock Text="Действия" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,7" /></StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>

            <StackPanel x:Name="ToolbarProperties" Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                        Width="{StaticResource ToolbarPropertiesWidth}">
                <!-- The colour of the mark and what stands inside it, in one capsule: the circle is
                     the outline and opens the stroke popover, the square beside it is the fill and
                     opens its own. Two properties, two ways in, and neither paints the other. -->
                <Button x:Name="ColorCapsule" MinWidth="36" Padding="10,0" Style="{StaticResource OverlayButton}" Click="OnColorCapsuleClick" PreviewMouseLeftButtonDown="OnColorCapsuleDown" ToolTip="Обводка" AutomationProperties.Name="{local:UiText Обводка}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StrokeDot" Width="18" Height="18" Fill="#FF3B30" Stroke="#D9DEE8" StrokeThickness="1" />
                        <Border x:Name="FillSquare" Width="18" Height="18" Margin="7,0,0,0" CornerRadius="4" Background="Transparent"
                                BorderBrush="#D9DEE8" BorderThickness="1" ToolTip="Заливка" AutomationProperties.Name="{local:UiText Заливка}"
                                PreviewMouseLeftButtonDown="OnFillSquareDown">
                            <Grid>
                                <Rectangle x:Name="FillSquareBlur" Visibility="Collapsed" Fill="{StaticResource BlurFillPreview}" />
                                <!-- No fill at all: the slash the reference draws through the square. -->
                                <Path x:Name="FillSquareNone" Margin="3" Stretch="Fill" Stroke="#FF5C5C" StrokeThickness="1.6" Data="M0,1 L1,0" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Button>
                <!-- The thickness and the pattern of a stroke, the size of a caption, or the shape of
                     a blur: one capsule, and the tool in the hand decides what it carries and what
                     it opens. The block keeps one width whatever that is, so the panel never jumps. -->
                <Button x:Name="LineCapsule" MinWidth="36" Margin="6,0,2,0" Padding="10,0" Style="{StaticResource OverlayButton}" Click="OnLineCapsuleClick" ToolTip="Толщина" AutomationProperties.Name="{local:UiText Толщина}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="LineCapsuleGlyph" Visibility="Collapsed" Margin="0,0,6,0" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock x:Name="LineCapsuleValue" FontSize="12" Foreground="#EEF2F8" VerticalAlignment="Center" Text="4 px" />
                        <Line x:Name="LineCapsuleSample" X1="0" Y1="3" X2="22" Y2="3" Margin="7,0,0,0" VerticalAlignment="Center"
                              Stroke="#D9DEE8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Path x:Name="LineCapsuleChevron" Width="9" Height="5" Margin="7,0,0,0" VerticalAlignment="Center" Stroke="{DynamicResource TextBrush}"
                              StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M0.5,1 L4.5,4 L8.5,1" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel x:Name="ToolbarActions" Grid.Row="0" Grid.Column="3" Orientation="Horizontal">
                <Border Width="1" Height="22" Margin="7,7" Background="{DynamicResource DividerBrush}" />
                <Button x:Name="UndoButton" Style="{StaticResource OverlayButton}" Click="OnUndoClick"><TextBlock FontFamily="{StaticResource IconFont}" FontSize="16" Text="&#xE7A7;" /></Button>
                <Button x:Name="RedoButton" Style="{StaticResource OverlayButton}" Click="OnRedoClick"><TextBlock FontFamily="{StaticResource IconFont}" FontSize="16" Text="&#xE7A6;" /></Button>
                <Button x:Name="SaveImageButton" Style="{StaticResource OverlayButton}" Click="OnSaveImageClick" AutomationProperties.Name="{local:UiText Сохранить на компьютер}">
                    <TextBlock FontFamily="{StaticResource IconFont}" FontSize="16" Text="&#xE74E;" />
                </Button>
                <Button x:Name="CopyImageButton" Style="{StaticResource OverlayButton}" Click="OnCopyImageClick" AutomationProperties.Name="{local:UiText Копировать снимок}">
                    <TextBlock FontFamily="{StaticResource IconFont}" FontSize="16" Text="&#xE8C8;" />
                </Button>
                <Button x:Name="DoneButton" Style="{StaticResource OverlayButton}" Click="OnDoneClick" Background="{DynamicResource AccentBrush}" Foreground="White" FontWeight="SemiBold" Content="Готово" />
            </StackPanel>
            </Grid>
        </Border>
        <Popup x:Name="AppearancePopup" PlacementTarget="{Binding ElementName=ColorCapsule}" Placement="Bottom" VerticalOffset="8" AllowsTransparency="True" StaysOpen="False" Closed="OnAppearanceClosed">
            <Border Width="280" Padding="18" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceLineBrush}" BorderThickness="1" CornerRadius="14" TextElement.Foreground="{DynamicResource TextBrush}" Cursor="Arrow" PreviewKeyDown="OnAppearanceKeyDown">
                <StackPanel>
                    <Grid Margin="0,0,0,12"><TextBlock Text="Обводка" FontWeight="SemiBold"/><Button HorizontalAlignment="Right" Width="22" MinWidth="22" Height="22" Padding="5" Style="{StaticResource OverlayButton}" Click="OnCloseAppearance" ToolTip="Закрыть"><TextBlock FontFamily="{StaticResource IconFont}" FontSize="11" Text="&#xE8BB;" Foreground="{DynamicResource TextBrush}"/></Button></Grid>
                    <!-- Four palettes of twelve, picked here and remembered between captures. The
                         quick row of five dots on the panel is gone with the dots themselves: the
                         twelve swatches below stand one click away, and the panel shows the colour. -->
                    <Border Background="{DynamicResource ElevatedBrush}" CornerRadius="8" Padding="3" Margin="0,0,0,12">
                        <UniformGrid x:Name="PaletteRow" Columns="4">
                            <ToggleButton x:Name="StandardPaletteSegment" Style="{StaticResource SegmentButton}" Tag="standard" Click="OnPaletteClick" FontSize="11" Content="Стандартная" AutomationProperties.Name="{local:UiText Стандартная}" />
                            <ToggleButton x:Name="PastelPaletteSegment" Style="{StaticResource SegmentButton}" Tag="pastel" Click="OnPaletteClick" FontSize="11" Content="Пастель" AutomationProperties.Name="{local:UiText Пастель}" />
                            <ToggleButton x:Name="NeonPaletteSegment" Style="{StaticResource SegmentButton}" Tag="neon" Click="OnPaletteClick" FontSize="11" Content="Неон" AutomationProperties.Name="{local:UiText Неон}" />
                            <ToggleButton x:Name="CustomPaletteSegment" Style="{StaticResource SegmentButton}" Tag="custom" Click="OnPaletteClick" FontSize="11" Content="Своя" AutomationProperties.Name="{local:UiText Своя}" />
                        </UniformGrid>
                    </Border>
                    <!-- The spectrum and the eyedropper stand under every palette: they are two ways
                         of picking a colour, not a property of one set. The row under them is the
                         set that is picked above, and the own one is what has been saved so far. -->
                    <StackPanel x:Name="SpectrumBlock" Margin="0,0,0,12">
                        <controls:ColorSpectrum x:Name="Spectrum" HorizontalAlignment="Center" ColorChanged="OnSpectrumChanged" />
                        <TextBlock Text="Сохранённые цвета" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,12,0,0" />
                    </StackPanel>
                    <WrapPanel x:Name="ColorPalette" Margin="-3,0,-3,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="ColorHex" Text="#FF3B30" MaxLength="7" Background="{DynamicResource ElevatedBrush}" Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}" BorderBrush="{DynamicResource ElevatedLineBrush}" Padding="9,6" LostKeyboardFocus="OnHexLostFocus" PreviewKeyDown="OnHexKeyDown" AutomationProperties.Name="{local:UiText Цвет HEX}"/>
                        <Button x:Name="EyedropperButton" Grid.Column="1" Style="{StaticResource OverlayButton}" Width="34" MinWidth="34" Height="34" Margin="6,0,0,0" Padding="0"
                                Click="OnEyedropperClick" ToolTip="Взять цвет с экрана" AutomationProperties.Name="{local:UiText Пипетка}">
                            <TextBlock FontFamily="{StaticResource IconFont}" FontSize="16" Text="&#xEF3C;" Foreground="{DynamicResource TextBrush}" />
                        </Button>
                        <!-- Nothing is saved into the own palette by itself any more: this is the
                             one way in, and it works from whichever set is being shown. -->
                        <Button x:Name="AddColorButton" Grid.Column="2" Style="{StaticResource OverlayButton}" Width="34" MinWidth="34" Height="34" Margin="6,0,0,0" Padding="0"
                                Click="OnAddColorClick" ToolTip="Добавить цвет в свою палитру" AutomationProperties.Name="{local:UiText Добавить цвет в свою палитру}">
                            <TextBlock FontFamily="{StaticResource IconFont}" FontSize="14" Text="&#xE710;" Foreground="{DynamicResource TextBrush}" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>
        <!-- The thickness of a stroke and the pattern of it, in one popover the way the reference
             draws them: the line capsule of the panel carries both and opens this. -->
        <Popup x:Name="ThicknessPopup" PlacementTarget="{Binding ElementName=LineCapsule}" Placement="Bottom" VerticalOffset="8" AllowsTransparency="True" StaysOpen="False" Closed="OnAppearanceClosed">
            <Border Width="252" Padding="18" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceLineBrush}" BorderThickness="1" CornerRadius="14" TextElement.Foreground="{DynamicResource TextBrush}" Cursor="Arrow" PreviewKeyDown="OnThicknessKeyDown">
                <StackPanel>
                    <Grid Margin="0,0,0,12"><TextBlock Text="Толщина" FontWeight="SemiBold"/><TextBlock x:Name="StrokeValue" HorizontalAlignment="Right"/></Grid>
                    <!-- The four presets and the range of the slider belong to the tool in the hand:
                         the pencil counts in a few pixels, the highlighter in tens of them. Both are
                         written by SyncAppearance, so the values live in one place in the code. -->
                    <Border Background="{DynamicResource ElevatedBrush}" CornerRadius="8" Padding="3">
                        <UniformGrid x:Name="ThicknessPresetRow" Columns="4">
                            <ToggleButton x:Name="ThicknessPreset1Segment" Style="{StaticResource SegmentButton}" Tag="2" Click="OnThicknessPresetClick" ToolTip="2 px" AutomationProperties.Name="2 px">
                                <Rectangle Width="24" Height="2" RadiusX="1" RadiusY="1" Fill="{DynamicResource TextBrush}" />
                            </ToggleButton>
                            <ToggleButton x:Name="ThicknessPreset2Segment" Style="{StaticResource SegmentButton}" Tag="4" Click="OnThicknessPresetClick" ToolTip="4 px" AutomationProperties.Name="4 px">
                                <Rectangle Width="24" Height="4" RadiusX="2" RadiusY="2" Fill="{DynamicResource TextBrush}" />
                            </ToggleButton>
                            <ToggleButton x:Name="ThicknessPreset3Segment" Style="{StaticResource SegmentButton}" Tag="6" Click="OnThicknessPresetClick" ToolTip="6 px" AutomationProperties.Name="6 px">
                                <Rectangle Width="24" Height="6" RadiusX="3" RadiusY="3" Fill="{DynamicResource TextBrush}" />
                            </ToggleButton>
                            <ToggleButton x:Name="ThicknessPreset4Segment" Style="{StaticResource SegmentButton}" Tag="8" Click="OnThicknessPresetClick" ToolTip="8 px" AutomationProperties.Name="8 px">
                                <Rectangle Width="24" Height="8" RadiusX="4" RadiusY="4" Fill="{DynamicResource TextBrush}" />
                            </ToggleButton>
                        </UniformGrid>
                    </Border>
                    <Slider x:Name="StrokeSlider" Margin="0,12,0,0" Style="{StaticResource StrokeSliderStyle}" Minimum="1" Maximum="16" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" ValueChanged="OnStrokeChanged" AutomationProperties.Name="{local:UiText Толщина линии}"/>
                    <Border Background="{DynamicResource ElevatedBrush}" CornerRadius="7" Height="36" Margin="0,12,0,0"><Line x:Name="StrokePreview" X1="15" Y1="18" X2="201" Y2="18" Stroke="#FF3B30" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Border>
                    <!-- The pattern of a stroke, under the width of it and in the same popover: the
                         dashes are measured in thicknesses of the pen, so the sample here, the mark
                         on screen and the mark in the exported PNG are one stroke at three sizes. -->
                    <TextBlock Text="Линия" FontWeight="SemiBold" Margin="0,18,0,8" />
                    <Border Background="{DynamicResource ElevatedBrush}" CornerRadius="8" Padding="3">
                        <UniformGrid x:Name="LineStyleRow" Columns="3">
                            <ToggleButton x:Name="LineStyleSolidSegment" Style="{StaticResource SegmentButton}" Tag="Solid" Click="OnLineStylePresetClick" ToolTip="Сплошная" AutomationProperties.Name="{local:UiText Сплошная}">
                                <Line X1="0" Y1="3" X2="44" Y2="3" Stroke="{DynamicResource TextBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </ToggleButton>
                            <ToggleButton x:Name="LineStyleDashedSegment" Style="{StaticResource SegmentButton}" Tag="Dashed" Click="OnLineStylePresetClick" ToolTip="Пунктир" AutomationProperties.Name="{local:UiText Пунктир}">
                                <Line X1="0" Y1="3" X2="44" Y2="3" Stroke="{DynamicResource TextBrush}" StrokeThickness="2" StrokeDashArray="3 2" />
                            </ToggleButton>
                            <ToggleButton x:Name="LineStyleDottedSegment" Style="{StaticResource SegmentButton}" Tag="Dotted" Click="OnLineStylePresetClick" ToolTip="Точки" AutomationProperties.Name="{local:UiText Точки}">
                                <Line X1="0" Y1="3" X2="44" Y2="3" Stroke="{DynamicResource TextBrush}" StrokeThickness="2" StrokeDashArray="0 2" StrokeDashCap="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </ToggleButton>
                        </UniformGrid>
                    </Border>
                </StackPanel>
            </Border>
        </Popup>
        <!-- The size a caption is typed in: presets, a slider and a preview, the way the thickness
             popover is built. The size belongs to the mark and travels into session.json with it. -->
        <Popup x:Name="FontSizePopup" PlacementTarget="{Binding ElementName=LineCapsule}" Placement="Bottom" VerticalOffset="8" AllowsTransparency="True" StaysOpen="False" Closed="OnAppearanceClosed">
            <Border Width="276" Padding="18" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceLineBrush}" BorderThickness="1" CornerRadius="14" TextElement.Foreground="{DynamicResource TextBrush}" Cursor="Arrow" PreviewKeyDown="OnFontSizeKeyDown">
                <StackPanel>
                    <Grid Margin="0,0,0,12"><TextBlock Text="Размер" FontWeight="SemiBold"/><TextBlock x:Name="FontSizeValue" HorizontalAlignment="Right"/></Grid>
                    <Border Background="{DynamicResource ElevatedBrush}" CornerRadius="8" Padding="3">
                        <UniformGrid x:Name="FontSizePresetRow" Columns="6">
                            <ToggleButton x:Name="FontSize1Segment" Style="{StaticResource SegmentButton}" Tag="12" Click="OnFontSizePresetClick" ToolTip="12 px" AutomationProperties.Name="12 px"><TextBlock Text="12" FontSize="12" /></ToggleButton>
                            <ToggleButton x:Name="FontSize2Segment" Style="{StaticResource SegmentButton}" Tag="16" Click="OnFontSizePresetClick" ToolTip="16 px" AutomationProperties.Name="16 px"><TextBlock Text="16" FontSize="12" /></ToggleButton>
                            <ToggleButton x:Name="FontSize3Segment" Style="{StaticResource SegmentButton}" Tag="20" Click="OnFontSizePresetClick" ToolTip="20 px" AutomationProperties.Name="20 px"><TextBlock Text="20" FontSize="12" /></ToggleButton>
                            <ToggleButton x:Name="FontSize4Segment" Style="{StaticResource SegmentButton}" Tag="24" Click="OnFontSizePresetClick" ToolTip="24 px" AutomationProperties.Name="24 px"><TextBlock Text="24" FontSize="12" /></ToggleButton>
                            <ToggleButton x:Name="FontSize5Segment" Style="{StaticResource SegmentButton}" Tag="32" Click="OnFontSizePresetClick" ToolTip="32 px" AutomationProperties.Name="32 px"><TextBlock Text="32" FontSize="12" /></ToggleButton>
                            <ToggleButton x:Name="FontSize6Segment" Style="{StaticResource SegmentButton}" Tag="48" Click="OnFontSizePresetClick" ToolTip="48 px" AutomationProperties.Name="48 px"><TextBlock Text="48" FontSize="12" /></ToggleButton>
                        </UniformGrid>
                    </Border>
                    <Slider x:Name="FontSizeSlider" Margin="0,12,0,0" Style="{StaticResource StrokeSliderStyle}" Minimum="8" Maximum="96" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" ValueChanged="OnFontSizeChanged" AutomationProperties.Name="{local:UiText Размер шрифта}"/>
                    <Border Background="{DynamicResource ElevatedBrush}" CornerRadius="7" Height="66" Margin="0,12,0,0">
                        <TextBlock x:Name="FontSizePreview" Text="Ag" FontFamily="Segoe UI Variable Text" Foreground="#FF3B30" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Border>
        </Popup>
        <!-- The four ways the inside of a region can be filled, and the colour that fills it. The
             segments and their handler are the ones that used to sit at the bottom of the colour
             popover; only the way in changed. -->
        <Popup x:Name="FillPopup" PlacementTarget="{Binding ElementName=FillSquare}" Placement="Bottom" VerticalOffset="8" AllowsTransparency="True" StaysOpen="False" Closed="OnAppearanceClosed">
            <Border Width="280" Padding="18" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceLineBrush}" BorderThickness="1" CornerRadius="14" TextElement.Foreground="{DynamicResource TextBrush}" Cursor="Arrow" PreviewKeyDown="OnFillKeyDown">
                <StackPanel>
                    <Grid Margin="0,0,0,12"><TextBlock Text="Заливка" FontWeight="SemiBold"/><TextBlock x:Name="FillValue" HorizontalAlignment="Right"/></Grid>
                    <Border x:Name="FillRow" Background="{DynamicResource ElevatedBrush}" CornerRadius="8" Padding="3">
                        <UniformGrid Columns="4">
                            <ToggleButton x:Name="FillNoneSegment" Style="{StaticResource SegmentButton}" Tag="None" Click="OnFillClick" ToolTip="Контур" AutomationProperties.Name="{local:UiText Контур}">
                                <Rectangle Width="20" Height="14" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" RadiusX="2" RadiusY="2" />
                            </ToggleButton>
                            <ToggleButton x:Name="FillSolidSegment" Style="{StaticResource SegmentButton}" Tag="Solid" Click="OnFillClick" ToolTip="Сплошная заливка" AutomationProperties.Name="{local:UiText Сплошная заливка}">
                                <Rectangle Width="20" Height="14" Fill="{DynamicResource TextBrush}" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" RadiusX="2" RadiusY="2" />
                            </ToggleButton>
                            <ToggleButton x:Name="FillTranslucentSegment" Style="{StaticResource SegmentButton}" Tag="Translucent" Click="OnFillClick" ToolTip="Полупрозрачная заливка" AutomationProperties.Name="{local:UiText Полупрозрачная заливка}">
                                <Rectangle Width="20" Height="14" Fill="#40D9DEE8" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" RadiusX="2" RadiusY="2" />
                            </ToggleButton>
                            <ToggleButton x:Name="FillBlurSegment" Style="{StaticResource SegmentButton}" Tag="Blur" Click="OnFillClick" ToolTip="Заливка размытием" AutomationProperties.Name="{local:UiText Заливка размытием}">
                                <Rectangle Width="20" Height="14" Fill="{StaticResource BlurFillPreview}" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" RadiusX="2" RadiusY="2" />
                            </ToggleButton>
                        </UniformGrid>
                    </Border>
                    <TextBlock Text="Цвет заливки" FontWeight="SemiBold" Margin="0,18,0,8"/>
                    <WrapPanel x:Name="FillPalette" Margin="-3,0,-3,0"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
