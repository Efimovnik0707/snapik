<UserControl x:Class="Snapik.App.Controls.AppearancePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- The colours of this control are tokens of the theme and never written down: a gallery of
             themes that does not survive a theme change would be the one control in the application
             that lies about what it is showing. -->
        <Style x:Key="Chevron" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ElevatedLineBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PressedBrush}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FocusBrush}" /></Trigger>
                            <!-- The end of the strip is a mark on the button, not a button switched off: an
                                 availability worked out from a layout pass stays wherever a pass with no width
                                 leaves it, and the gallery then reads as one that does not scroll at all. It
                                 looks the way it always did, and a press at the end simply moves nothing. -->
                            <Trigger Property="Tag" Value="end">
                                <Setter Property="Opacity" Value="0.42" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemeCard" TargetType="Button">
            <Setter Property="Width" Value="132" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="{DynamicResource ElevatedBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10" Padding="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentDot" TargetType="RadioButton">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Ellipse Fill="{TemplateBinding Background}" />
                            <Ellipse x:Name="Ring" Margin="1" Stroke="Transparent" StrokeThickness="2" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="#FFFFFF" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource FocusBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock x:Name="ThemeCaption" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8" />
        <Grid Margin="0,0,0,22">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button x:Name="PreviousTheme" Style="{StaticResource Chevron}" Click="OnPreviousTheme">
                <Path Width="7" Height="11" Stretch="Uniform" Data="M7,1 L2,6 L7,11" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Button>
            <!-- The gallery scrolls, it does not wrap: six cards of 132 px do not fit into 520, and
                 the chevrons move it by one card at a time. -->
            <ScrollViewer x:Name="Gallery" Grid.Column="1" Margin="8,0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          ScrollChanged="OnGalleryScrolled" PreviewMouseWheel="OnGalleryWheel">
                <StackPanel x:Name="ThemeCards" Orientation="Horizontal" />
            </ScrollViewer>
            <Button x:Name="NextTheme" Grid.Column="2" Style="{StaticResource Chevron}" Click="OnNextTheme">
                <Path Width="7" Height="11" Stretch="Uniform" Data="M1,1 L6,6 L1,11" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Button>
        </Grid>

        <TextBlock x:Name="AccentCaption" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8" />
        <StackPanel x:Name="AccentRow" Orientation="Horizontal" Margin="0,0,0,18" />

        <!-- Shown only where the owner asks for it: the settings carry the palette row, the wizard
             does not ask a first-time user to pick between twelve-colour sets. -->
        <StackPanel x:Name="PaletteBlock" Visibility="Collapsed" Margin="0,0,0,18">
            <TextBlock x:Name="PaletteCaption" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="StandardPalette" Style="{StaticResource SegmentButton}" GroupName="AnnotationPalette" Tag="standard" Checked="OnPaletteChecked" />
                <RadioButton x:Name="PastelPalette" Style="{StaticResource SegmentButton}" GroupName="AnnotationPalette" Tag="pastel" Checked="OnPaletteChecked" />
                <RadioButton x:Name="CustomPalette" Style="{StaticResource SegmentButton}" GroupName="AnnotationPalette" Tag="custom" Checked="OnPaletteChecked" />
            </StackPanel>
        </StackPanel>

        <Border x:Name="Sample" CornerRadius="10" Padding="14,12"
                Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource ElevatedLineBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="70" Height="34" BorderThickness="3" BorderBrush="{DynamicResource AccentBrush}" />
                <Border Width="22" Height="22" CornerRadius="11" Margin="14,0,0,0" Background="{DynamicResource AccentBrush}">
                    <TextBlock Text="1" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border Height="30" CornerRadius="7" Padding="12,0" Margin="14,0,0,0" Background="{DynamicResource AccentBrush}">
                    <TextBlock x:Name="SampleDone" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="SampleCaption" Margin="14,0,0,0" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
