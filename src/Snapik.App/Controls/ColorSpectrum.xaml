<UserControl x:Class="Snapik.App.Controls.ColorSpectrum"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal">
        <!-- Saturation runs left to right over the hue in force, brightness top to bottom over
             black: two layers, because a single brush cannot be both. -->
        <Border BorderThickness="1" BorderBrush="{DynamicResource ElevatedLineBrush}" CornerRadius="6">
            <Grid x:Name="Square" Width="160" Height="160" Cursor="Cross"
                  MouseLeftButtonDown="OnSquarePressed" MouseMove="OnSquareMoved" MouseLeftButtonUp="OnReleased">
                <Rectangle x:Name="SaturationLayer" />
                <Rectangle x:Name="BrightnessLayer">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#FF000000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Canvas x:Name="SquareLayer" IsHitTestVisible="False">
                    <!-- A white ring over a black one: the marker has to be seen on both ends of
                         the square. -->
                    <Ellipse x:Name="SquareMarkerShadow" Width="14" Height="14" Stroke="#66000000" StrokeThickness="3" />
                    <Ellipse x:Name="SquareMarker" Width="14" Height="14" Stroke="#FFFFFF" StrokeThickness="1.5" />
                </Canvas>
            </Grid>
        </Border>
        <Border BorderThickness="1" BorderBrush="{DynamicResource ElevatedLineBrush}" CornerRadius="6" Margin="12,0,0,0">
            <Grid x:Name="Hue" Width="16" Height="160" Cursor="Cross"
                  MouseLeftButtonDown="OnHuePressed" MouseMove="OnHueMoved" MouseLeftButtonUp="OnReleased">
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FF0000" Offset="0" />
                            <GradientStop Color="#FFFF00" Offset="0.1667" />
                            <GradientStop Color="#00FF00" Offset="0.3333" />
                            <GradientStop Color="#00FFFF" Offset="0.5" />
                            <GradientStop Color="#0000FF" Offset="0.6667" />
                            <GradientStop Color="#FF00FF" Offset="0.8333" />
                            <GradientStop Color="#FF0000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Canvas x:Name="HueLayer" IsHitTestVisible="False">
                    <Border x:Name="HueMarker" Width="22" Height="4" CornerRadius="2" Background="#FFFFFF" BorderBrush="#66000000" BorderThickness="1" />
                </Canvas>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
