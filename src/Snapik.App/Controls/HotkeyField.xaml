<UserControl x:Class="Snapik.App.Controls.HotkeyField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" IsTabStop="True" FocusVisualStyle="{x:Null}"
             ToolTip="Нажмите своё сочетание клавиш"
             GotKeyboardFocus="OnBeginRecording" LostKeyboardFocus="OnLostFocus"
             PreviewMouseLeftButtonDown="OnBeginRecordingClick"
             PreviewKeyDown="OnCaptureKeyDown" PreviewKeyUp="OnCaptureKeyUp">
    <Border x:Name="Frame" Background="#252B35" BorderBrush="#445064" BorderThickness="1" CornerRadius="8" Padding="11,8" Cursor="Hand">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Path Width="21" Height="14" Stretch="Uniform" VerticalAlignment="Center" Stroke="#9AA7B8" StrokeThickness="1.3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M1,2 L21,2 L21,15 L1,15 Z M4,5.5 L5,5.5 M8,5.5 L9,5.5 M12,5.5 L13,5.5 M16,5.5 L18,5.5 M4,9 L5,9 M8,9 L9,9 M12,9 L13,9 M16,9 L18,9 M7,12 L15,12" />
            <StackPanel x:Name="KeyCaps" Grid.Column="1" Orientation="Horizontal" Margin="11,0,10,0" VerticalAlignment="Center" />
            <TextBlock x:Name="Caption" Grid.Column="2" Text="Нажми, чтобы изменить" Foreground="#8F9AAA" FontSize="11" VerticalAlignment="Center" />
        </Grid>
    </Border>
</UserControl>
