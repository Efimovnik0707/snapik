<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- One of the six palettes ThemeService swaps into the application resources. Every palette
         carries the same sixteen keys: a key missing from one of them would resolve under one
         theme and leave a DynamicResource unresolved under another. The chrome reads them through
         DynamicResource, so a swap repaints the open windows without rebuilding anything.
         Dawn: a light gradient, ink text, white cards on top of it. -->
    <LinearGradientBrush x:Key="SurfaceBrush" StartPoint="0,0" EndPoint="0.35,1">
        <GradientStop Offset="0" Color="#FFF4EC" />
        <GradientStop Offset="1" Color="#F1ECFF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SurfaceBarBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#FFF4EC" />
        <GradientStop Offset="1" Color="#F1ECFF" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SurfaceLineBrush" Color="#14000000" />
    <SolidColorBrush x:Key="ElevatedBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ElevatedLineBrush" Color="#E3E7ED" />
    <SolidColorBrush x:Key="HoverBrush" Color="#0D000000" />
    <SolidColorBrush x:Key="PressedBrush" Color="#17000000" />
    <SolidColorBrush x:Key="DividerBrush" Color="#14000000" />
    <SolidColorBrush x:Key="TextBrush" Color="#172033" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#5E687A" />
    <SolidColorBrush x:Key="TextFaintBrush" Color="#8A93A3" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#47000000" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#73000000" />
    <Color x:Key="ShadowColor">#000000</Color>
    <sys:Double x:Key="ShadowOpacity">0.15</sys:Double>
    <SolidColorBrush x:Key="DangerBrush" Color="#B42318" />
</ResourceDictionary>
