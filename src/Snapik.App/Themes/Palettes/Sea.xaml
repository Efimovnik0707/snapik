<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- One of the seven palettes ThemeService swaps into the application resources. Every palette
         carries the same fourteen keys: a key missing from one of them would resolve under one
         theme and leave a DynamicResource unresolved under another. The chrome reads them through
         DynamicResource, so a swap repaints the open windows without rebuilding anything.
         Sea: a gradient surface; the rim is the leading tone of that gradient. -->
    <LinearGradientBrush x:Key="SurfaceBrush" StartPoint="0,0" EndPoint="0.35,1">
        <GradientStop Offset="0" Color="#163A44" />
        <GradientStop Offset="1" Color="#1B3A2C" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SurfaceBarBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#163A44" />
        <GradientStop Offset="1" Color="#1B3A2C" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SurfaceLineBrush" Color="#4050DCC8" />
    <SolidColorBrush x:Key="ElevatedBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="ElevatedLineBrush" Color="#4050DCC8" />
    <SolidColorBrush x:Key="HoverBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="PressedBrush" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="DividerBrush" Color="#4D50DCC8" />
    <SolidColorBrush x:Key="TextBrush" Color="#EEF2F8" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#C6CEDA" />
    <SolidColorBrush x:Key="TextFaintBrush" Color="#A9B4C2" />
    <Color x:Key="ShadowColor">#000000</Color>
    <sys:Double x:Key="ShadowOpacity">0.45</sys:Double>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF6B6B" />
</ResourceDictionary>
