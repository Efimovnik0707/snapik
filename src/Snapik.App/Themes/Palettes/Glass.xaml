<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- One of the six palettes ThemeService swaps into the application resources. Every palette
         carries the same sixteen keys: a key missing from one of them would resolve under one
         theme and leave a DynamicResource unresolved under another. The chrome reads them through
         DynamicResource, so a swap repaints the open windows without rebuilding anything.
         Glass: the frosted gradient of the reference, violet into rose into slate, under a light
         rim. The backdrop behind the window is still not blurred; real acrylic is a step of its own
         and waits for the round where these windows stop being layered. -->
    <LinearGradientBrush x:Key="SurfaceBrush" StartPoint="0,0" EndPoint="0.6,1">
        <GradientStop Offset="0" Color="#5F5C8C" />
        <GradientStop Offset="0.55" Color="#7E5878" />
        <GradientStop Offset="1" Color="#58627A" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SurfaceBarBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#5F5C8C" />
        <GradientStop Offset="0.55" Color="#7E5878" />
        <GradientStop Offset="1" Color="#58627A" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SurfaceLineBrush" Color="#38FFFFFF" />
    <SolidColorBrush x:Key="ElevatedBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="ElevatedLineBrush" Color="#38FFFFFF" />
    <SolidColorBrush x:Key="HoverBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="PressedBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="DividerBrush" Color="#3DFFFFFF" />
    <SolidColorBrush x:Key="TextBrush" Color="#EEF2F8" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#DDD6E6" />
    <SolidColorBrush x:Key="TextFaintBrush" Color="#C5BFD3" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#47FFFFFF" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#73FFFFFF" />
    <Color x:Key="ShadowColor">#000000</Color>
    <sys:Double x:Key="ShadowOpacity">0.35</sys:Double>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF6B6B" />
</ResourceDictionary>
