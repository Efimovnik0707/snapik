<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Accent "cyan-blue". Hover is the accent darkened by 12 %, pressed by 22 %, the light tone is the
         accent mixed with white and the soft one is the accent at 33 % over the surface below it.
         Every accent dictionary must keep exactly these eight keys. AccentFlatColor is for the
         places that need a Color rather than a Brush (an alpha mix, the exported PNG); everything
         that paints takes AccentBrush.
         This one is a gradient: AccentBrush runs at 135 degrees, and both AccentColor and
         AccentFlatColor are its first stop, because the call sites that read AccentColor cast it
         to a Color. -->
    <Color x:Key="AccentColor">#22C1C3</Color>
    <Color x:Key="AccentFlatColor">#22C1C3</Color>
    <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#22C1C3" />
        <GradientStop Offset="1" Color="#2F8CFF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentHoverBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#1EAAAC" />
        <GradientStop Offset="1" Color="#297BE0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentPressedBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#1B9798" />
        <GradientStop Offset="1" Color="#256DC7" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#5522C1C3" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#69C1EA" />
    <SolidColorBrush x:Key="FocusBrush" Color="#69C1EA" />
</ResourceDictionary>
