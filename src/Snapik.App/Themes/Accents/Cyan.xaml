<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Accent "cyan". Hover is the accent darkened by 12 %, pressed by 22 %, the light tone is the
         accent mixed with white and the soft one is the accent at 33 % over the surface below it.
         Every accent dictionary must keep exactly these eight keys. AccentFlatColor is for the
         places that need a Color rather than a Brush (an alpha mix, the exported PNG); everything
         that paints takes AccentBrush. -->
    <Color x:Key="AccentColor">#22C1C3</Color>
    <Color x:Key="AccentFlatColor">#22C1C3</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1EAAAC" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1B9798" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#5522C1C3" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#74D8D9" />
    <SolidColorBrush x:Key="FocusBrush" Color="#74D8D9" />
</ResourceDictionary>
