<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Accent "orange-rose". Hover is the accent darkened by 12 %, pressed by 22 %, the light tone is the
         accent mixed with white and the soft one is the accent at 33 % over the surface below it.
         Every accent dictionary must keep exactly these eight keys. AccentFlatColor is for the
         places that need a Color rather than a Brush (an alpha mix, the exported PNG); everything
         that paints takes AccentBrush.
         This one is a gradient: AccentBrush runs at 135 degrees, and both AccentColor and
         AccentFlatColor are its first stop, because the call sites that read AccentColor cast it
         to a Color. -->
    <Color x:Key="AccentColor">#FF8C42</Color>
    <Color x:Key="AccentFlatColor">#FF8C42</Color>
    <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF8C42" />
        <GradientStop Offset="1" Color="#FF4D6D" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentHoverBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#E07B3A" />
        <GradientStop Offset="1" Color="#E04460" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentPressedBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#C76D33" />
        <GradientStop Offset="1" Color="#C73C55" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#55FF8C42" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FF988A" />
    <SolidColorBrush x:Key="FocusBrush" Color="#FF988A" />
</ResourceDictionary>
