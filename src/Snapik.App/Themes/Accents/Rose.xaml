<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Accent "rose". Hover is the accent darkened by 12 %, pressed by 22 %, the light tone is the
         accent mixed with white and the soft one is the accent at 33 % over the surface below it.
         Every accent dictionary must keep exactly these eight keys. AccentFlatColor is for the
         places that need a Color rather than a Brush (an alpha mix, the exported PNG); everything
         that paints takes AccentBrush. -->
    <Color x:Key="AccentColor">#FF5C8A</Color>
    <Color x:Key="AccentFlatColor">#FF5C8A</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#E05179" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#C7486C" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#55FF5C8A" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FF98B5" />
    <SolidColorBrush x:Key="FocusBrush" Color="#FF98B5" />
</ResourceDictionary>
