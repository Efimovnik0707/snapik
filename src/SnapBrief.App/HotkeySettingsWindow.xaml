<Window x:Class="SnapBrief.App.HotkeySettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SnapBrief.App" xmlns:controls="clr-namespace:SnapBrief.App.Controls"
 Title="Настройки SnapBrief" Width="530" Height="520" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Foreground="#EEF2F8"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <Window.Resources>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EEF2F8"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#252B35"/><Setter Property="Foreground" Value="#EEF2F8"/><Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="#445064"/><Setter Property="Padding" Value="10,7"/></Style>
  <Style x:Key="AccentDot" TargetType="RadioButton">
   <Setter Property="Width" Value="26"/><Setter Property="Height" Value="26"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Grid><Ellipse x:Name="Ring" Stroke="Transparent" StrokeThickness="2"/><Ellipse Margin="4" Fill="{TemplateBinding Background}"/></Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="#5C6879"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="White"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource FocusBrush}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="#EEF2F8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Tab" Padding="15,9" Margin="0,0,6,12" CornerRadius="8" Background="#252B35"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="Background" Value="{DynamicResource AccentSoftBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border Background="#171B22" BorderBrush="#354052" BorderThickness="1" CornerRadius="16" Padding="24">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,22" Background="Transparent" MouseLeftButtonDown="OnHeaderDrag">
   <TextBlock Text="Настройки" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/>
   <Button x:Name="CloseButton" Style="{StaticResource BaseButton}" controls:ButtonChrome.HoverBackground="#2A3240" controls:ButtonChrome.PressedBackground="#20262F" HorizontalAlignment="Right" VerticalAlignment="Center" Width="28" Height="28" MinHeight="28" Padding="0" Click="OnClose" ToolTip="Закрыть" AutomationProperties.Name="{local:UiText Закрыть}">
    <Path Data="M0,0 L11,11 M11,0 L0,11" Stroke="#EEF2F8" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
   </Button>
  </Grid>
  <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
   <TabItem Header="Общие"><StackPanel Margin="0,10,0,0">
    <CheckBox x:Name="NotificationsBox" Content="Показывать уведомления"/>
    <CheckBox x:Name="RememberBox" Content="Предлагать ту же область, что в прошлый раз"/>
    <CheckBox x:Name="CursorBox" Content="Показывать курсор мыши на скриншоте"/>
    <CheckBox x:Name="ClearStackBox" Content="{local:UiText Очищать ленту после вставки}"/>
    <CheckBox x:Name="SoundsBox" Content="{local:UiText Звуки}" Margin="0,0,0,8"/>
    <StackPanel x:Name="VolumeRow" Margin="22,0,0,16">
     <TextBlock Text="Громкость" Margin="0,0,0,5"/>
     <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Width="200" HorizontalAlignment="Left" AutomationProperties.Name="{local:UiText Громкость}"/>
    </StackPanel>
    <TextBlock Text="Акцент" Margin="0,4,0,7"/>
    <StackPanel x:Name="AccentRow" Orientation="Horizontal" Margin="0,0,0,18"/>
    <TextBlock Text="Язык" Margin="0,4,0,7"/>
    <ComboBox x:Name="LanguageBox" Width="180" HorizontalAlignment="Left"><ComboBoxItem Content="Русский"/><ComboBoxItem Content="English"/></ComboBox>
   </StackPanel></TabItem>
   <TabItem Header="Клавиши"><StackPanel Margin="0,10,0,0">
    <CheckBox x:Name="CaptureEnabledBox" Content="Сделать скриншот" Margin="0,0,0,7"/>
    <controls:HotkeyField x:Name="CaptureField" Margin="0,0,0,20" HotkeyChanged="OnHotkeyChanged" AutomationProperties.Name="{local:UiText Сделать скриншот}"/>
    <CheckBox x:Name="FullscreenEnabledBox" Content="Скриншот всего экрана в папку" Margin="0,0,0,7"/>
    <controls:HotkeyField x:Name="FullscreenField" HotkeyChanged="OnHotkeyChanged" AutomationProperties.Name="{local:UiText Скриншот всего экрана в папку}"/>
    <!-- The shortcut of the whole screen is off until it is asked for, and the chip is the asking:
         it carries the first free combination and switches the shortcut on with it. -->
    <Button x:Name="SuggestChip" Style="{StaticResource BaseButton}" Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource ElevatedLineBrush}"
            HorizontalAlignment="Left" Margin="0,10,0,0" MinHeight="28" Padding="12,4" FontSize="12" Click="OnSuggestShortcut" Visibility="Collapsed"/>
   </StackPanel></TabItem>
   <TabItem Header="Сохранение"><StackPanel Margin="0,10,0,0">
    <CheckBox x:Name="AutoSaveBox" Content="{local:UiText Автоматически сохранять готовые снимки}" Margin="0,0,0,16"/>
    <TextBlock Text="Формат" Margin="0,0,0,7"/>
    <ComboBox x:Name="FormatBox" Width="140" HorizontalAlignment="Left"><ComboBoxItem Content="PNG"/><ComboBoxItem Content="JPEG"/></ComboBox>
    <TextBlock x:Name="QualityLabel" Margin="0,14,0,0"/>
    <Slider x:Name="QualitySlider" Minimum="1" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,6,0,16"/>
    <TextBlock Text="Папка сохранения" Margin="0,0,0,7"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><TextBox x:Name="DirectoryBox"/><Button Grid.Column="1" Style="{StaticResource BaseButton}" controls:ButtonChrome.HoverBackground="#2A3240" controls:ButtonChrome.PressedBackground="#20262F" Foreground="White" Margin="6,0,0,0" Padding="0" Content="…" Click="OnBrowseDirectory" ToolTip="Выбрать папку"/></Grid>
   </StackPanel></TabItem>
  </TabControl>
  <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="#FF9B95" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,8"/>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
   <Button Style="{StaticResource BaseButton}" controls:ButtonChrome.HoverBackground="#2A3240" controls:ButtonChrome.PressedBackground="#20262F" Foreground="White" Margin="0,0,8,0" IsCancel="True" Content="Отмена"/>
   <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnSave" Content="Сохранить"/>
  </StackPanel>
 </Grid>
 </Border>
</Window>
