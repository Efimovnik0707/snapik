<Window x:Class="SnapBrief.App.EdgeStackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnapBrief — Стопка снимков" AutomationProperties.Name="SnapBrief — Стопка снимков"
        Width="196" MinHeight="128" MaxHeight="620" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        BorderThickness="0" BorderBrush="Transparent" ShowInTaskbar="False" ShowActivated="False" Topmost="False" WindowStartupLocation="Manual">
    <Window.Resources>
        <Style x:Key="StackButton" TargetType="Button">
            <Setter Property="Height" Value="36" /><Setter Property="Padding" Value="10,0" />
            <Setter Property="Foreground" Value="#EEF2F8" /><Setter Property="Background" Value="#242A33" />
            <Setter Property="BorderBrush" Value="#333C49" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="B" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#303845" /><Setter TargetName="B" Property="BorderBrush" Value="#536175" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#7AB8FF" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#F2171A20" /><Setter Property="Foreground" Value="#EEF2F8" />
            <Setter Property="BorderBrush" Value="#39424E" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#EEF2F8" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
                <Border x:Name="MenuRow" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuRow" Property="Background" Value="#303845" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="MenuRow" Property="Opacity" Value="0.45" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#303845" /></Trigger></Style.Triggers>
        </Style>
    </Window.Resources>
    <Border x:Name="Shell" Margin="10" Padding="10" CornerRadius="16" Background="#F2171A20">
        <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="5" Opacity="0.42" /></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Grid.Row="0" Height="28" MouseLeftButtonDown="OnHeaderMouseDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="28" /><ColumnDefinition Width="24" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="#2F8CFF" Margin="1,0,7,0" />
                    <TextBlock Foreground="White" FontSize="12" FontWeight="SemiBold" Text="SnapBrief" />
                    <Border Margin="7,0,0,0" Padding="6,2" CornerRadius="8" Background="#2B3440">
                        <TextBlock x:Name="CountText" Foreground="#BFC8D6" FontSize="11" Text="0" />
                    </Border>
                </StackPanel>
                <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="#BFC8D6" Click="OnMoreClick" ToolTip="Ещё">
                    <Path Width="14" Height="3" Fill="#BFC8D6" Data="M1,1.5 A1.5,1.5 0 1 0 4,1.5 A1.5,1.5 0 1 0 1,1.5 M6,1.5 A1.5,1.5 0 1 0 9,1.5 A1.5,1.5 0 1 0 6,1.5 M11,1.5 A1.5,1.5 0 1 0 14,1.5 A1.5,1.5 0 1 0 11,1.5" />
                </Button>
                <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Click="OnHideClick" ToolTip="Свернуть в трей" AutomationProperties.Name="Свернуть в трей">
                    <Path Width="10" Height="10" Stroke="#BFC8D6" StrokeThickness="1.5" Data="M0,0 L10,10 M10,0 L0,10" />
                </Button>
            </Grid>

            <ScrollViewer Background="Transparent" BorderThickness="0" Grid.Row="1" MaxHeight="346" Margin="0,7,0,8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="CaptureList" ItemsSource="{Binding Captures}" AllowDrop="True"
                              PreviewMouseLeftButtonDown="OnCaptureListMouseDown" PreviewMouseMove="OnCaptureListMouseMove" Drop="OnCaptureListDrop">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="ThumbCard" Margin="0,0,0,7" Height="82" CornerRadius="10" Background="#242A33" BorderBrush="#39424E" BorderThickness="1" ClipToBounds="True">
                                <Grid>
                                    <Button Padding="0" Background="Transparent" BorderThickness="0" Click="OnOpenCaptureClick" Tag="{Binding}" ToolTip="Открыть снимок">
                                        <Grid>
                                            <Image Source="{Binding Image}" Stretch="UniformToFill" Opacity="0.82" />
                                            <Border VerticalAlignment="Bottom" Height="25" Background="#D9171A20">
                                                <StackPanel Orientation="Horizontal" Margin="7,0" VerticalAlignment="Center">
                                                    <Border Width="20" Height="20" CornerRadius="10" Background="#2F8CFF">
                                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="11" FontWeight="Bold" Text="{Binding DisplayLabel}" />
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="DeleteButton" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0" Width="27" Height="27" Padding="7" Opacity="0" Background="#E6171A20" BorderThickness="0" Click="OnRemoveCaptureClick" Tag="{Binding}" ToolTip="Удалить">
                                        <Path Stroke="White" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M1,1 L9,9 M9,1 L1,9" />
                                    </Button>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=ThumbCard}" Value="True"><Setter TargetName="DeleteButton" Property="Opacity" Value="1" /></DataTrigger>
                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=ThumbCard}" Value="True"><Setter TargetName="DeleteButton" Property="Opacity" Value="1" /></DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Button Grid.Row="2" Style="{StaticResource StackButton}" Background="#2F8CFF" BorderBrush="#2F8CFF" Click="OnCaptureClick">
                <StackPanel Orientation="Horizontal">
                    <Path Width="15" Height="15" Margin="0,0,7,0" Stroke="White" StrokeThickness="1.6" StrokeLineJoin="Round" Data="M2,5 L2,3 L6,3 L7,1.5 L11,1.5 L12,3 L16,3 L16,13 L2,13 Z M9,5 A3,3 0 1 0 9,11 A3,3 0 1 0 9,5" />
                    <TextBlock Text="Новый снимок" FontWeight="SemiBold" />
                </StackPanel>
            </Button>

            <Grid Grid.Row="3" Margin="0" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                <Button x:Name="TargetButton" Height="36" Style="{StaticResource StackButton}" HorizontalContentAlignment="Left" Click="OnTargetClick" ToolTip="Получатель">
                    <DockPanel LastChildFill="True">
                        <Ellipse DockPanel.Dock="Left" Width="7" Height="7" Fill="#2F8CFF" Margin="0,0,8,0" />
                        <Path DockPanel.Dock="Right" Width="8" Height="5" Margin="8,0,0,0" Fill="#AEB8C7" Data="M0,0 L4,4 L8,0 Z" />
                        <TextBlock x:Name="TargetCaption" VerticalAlignment="Center" Foreground="#EEF2F8" FontSize="12" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Button>
                <Button x:Name="PasteButton" Grid.Column="1" Margin="5,0,0,0" Style="{StaticResource StackButton}" Padding="9" Click="OnPasteClick" IsEnabled="False" ToolTip="Подготовить и вставить в черновик">
                    <Path Width="14" Height="14" Stroke="White" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M7,13 L7,1 M2,6 L7,1 L12,6" />
                </Button>
            </Grid>
            <Grid Grid.Row="5" Margin="2,8,2,0">
                <TextBlock x:Name="StatusText" Visibility="Collapsed" Foreground="#FF9B95" FontSize="11" TextWrapping="Wrap" />
                <Button x:Name="UndoRemoveButton" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="5,1" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Foreground="#7AB8FF" FontSize="11" Content="Вернуть" Click="OnRestoreRemovedClick" />
            </Grid>
        </Grid>
    </Border>
</Window>
