<Window x:Class="SnapBrief.App.EdgeStackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SnapBrief.App"
        Title="{local:UiText SnapBrief — Лента снимков}" AutomationProperties.Name="{local:UiText SnapBrief — Лента снимков}"
        Width="208" MinHeight="128" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        BorderThickness="0" BorderBrush="Transparent" ShowInTaskbar="False" ShowActivated="False" Topmost="False" WindowStartupLocation="Manual">
    <Window.Resources>
        <Style x:Key="StackButton" TargetType="Button">
            <Setter Property="Height" Value="36" /><Setter Property="Padding" Value="10,0" />
            <Setter Property="Foreground" Value="#EEF2F8" /><Setter Property="Background" Value="#242A33" />
            <Setter Property="BorderBrush" Value="#333C49" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="B" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#303845" /><Setter TargetName="B" Property="BorderBrush" Value="#536175" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource FocusBrush}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <!-- The icons of the header: the default WPF template lit them with a pale plate and left the
             icon itself grey, so hovering read as fading. Path does not inherit Foreground, which is
             why every icon below binds its Stroke (or Fill) to the Foreground of its own button: one
             trigger then repaints the plate and the icon together. -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="26" /><Setter Property="Height" Value="26" /><Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#D9DEE8" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#29303A" /><Setter Property="Foreground" Value="White" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#222932" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FocusBrush}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <!-- The close of a card: round and 24 px, and it lies on a photograph, so it carries a dark
             plate of its own. A style of its own rather than BasedOn: CornerRadius lives inside the
             template, and inheritance cannot reach it. -->
        <Style x:Key="CardCloseButton" TargetType="Button">
            <Setter Property="Width" Value="24" /><Setter Property="Height" Value="24" /><Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#CC0F1218" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#D9DEE8" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#E62A313C" /><Setter Property="Foreground" Value="White" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#E6222932" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FocusBrush}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#F2171A20" /><Setter Property="Foreground" Value="#EEF2F8" />
            <Setter Property="BorderBrush" Value="#39424E" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#EEF2F8" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
                <Border x:Name="MenuRow" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuRow" Property="Background" Value="#303845" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="MenuRow" Property="Opacity" Value="0.45" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#303845" /></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="StackScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="7" />
            <Setter Property="Margin" Value="5,2,0,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" /></Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Grip" Background="#657083" CornerRadius="4" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#8A96A9" /></Trigger>
                                                    <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource FocusBrush}" /></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" /></Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
    <Border x:Name="Shell" Margin="10" Padding="10" CornerRadius="16" Background="#F2171A20">
        <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="5" Opacity="0.42" /></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Grid.Row="0" Height="28" MouseLeftButtonDown="OnHeaderMouseDown">
                <!-- Three columns of the same 30 px: a button of 26 sits in the middle of each and
                     keeps a gap of four from its neighbour. -->
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="30" /><ColumnDefinition Width="30" /><ColumnDefinition Width="30" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Margin="1,0,7,0" />
                    <TextBlock Foreground="White" FontSize="12" FontWeight="SemiBold" Text="SnapBrief" />
                    <Border Margin="7,0,0,0" Padding="6,2" CornerRadius="8" Background="#2B3440">
                        <TextBlock x:Name="CountText" Foreground="#BFC8D6" FontSize="11" Text="0" />
                    </Border>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource IconButton}" Click="OnClearStackClick" ToolTip="Очистить ленту" AutomationProperties.Name="Очистить ленту">
                    <Path Stretch="Uniform" Width="12" Height="13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeLineJoin="Round" Data="M1,3 L13,3 M5.5,3 L5.5,1.5 L8.5,1.5 L8.5,3 M2.6,3 L3.4,13 L10.6,13 L11.4,3" />
                </Button>
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Click="OnMoreClick" ToolTip="Ещё">
                    <Path Width="14" Height="3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M1,1.5 A1.5,1.5 0 1 0 4,1.5 A1.5,1.5 0 1 0 1,1.5 M6,1.5 A1.5,1.5 0 1 0 9,1.5 A1.5,1.5 0 1 0 6,1.5 M11,1.5 A1.5,1.5 0 1 0 14,1.5 A1.5,1.5 0 1 0 11,1.5" />
                </Button>
                <Button Grid.Column="3" Style="{StaticResource IconButton}" Click="OnHideClick" ToolTip="Свернуть в трей" AutomationProperties.Name="Свернуть в трей">
                    <Path Stretch="Uniform" Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Data="M0,0 L10,10 M10,0 L0,10" />
                </Button>
            </Grid>

            <!-- The height is the one the corner grip drags and the settings remember, and it is a
                 height, not a maximum: the window is on SizeToContent and has to follow the grip
                 even when the list holds one card. PositionAtEdge sets it for every showing. -->
            <ListBox x:Name="CaptureList" Grid.Row="1" ItemsSource="{Binding Captures}" AllowDrop="True" Height="372" Margin="0,7,0,8" Padding="0,0,0,52"
                     Background="Transparent" BorderThickness="0" SelectionMode="Single" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                     PreviewMouseLeftButtonDown="OnCaptureListMouseDown" PreviewMouseMove="OnCaptureListMouseMove"
                     PreviewMouseWheel="OnCaptureListMouseWheel" Drop="OnCaptureListDrop">
                <ListBox.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource StackScrollBar}" /></ListBox.Resources>
                <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" />
                        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Panel.ZIndex" Value="20" /></Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Panel.ZIndex" Value="30" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="ThumbCard" Margin="0,0,0,-48" Height="78" CornerRadius="11" Background="#242A33"
                                    BorderBrush="#46505E" BorderThickness="1" ClipToBounds="True" MouseEnter="OnCaptureThumbMouseEnter">
                                <!-- The shadow goes up (Direction 90), not down as a shadow usually does: the cards
                                     overlap by 48 px, and the next card is drawn over this one, so a shadow cast
                                     downwards would be covered by it. The visible seam is the top edge of the card
                                     above, and that is where the stack has to be readable. -->
                                <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.5" Direction="90" /></Border.Effect>
                                <Grid>
                                    <Button x:Name="ThumbContent" Padding="0" Background="Transparent" BorderThickness="0" Click="OnOpenCaptureClick" Tag="{Binding}" ToolTip="Открыть снимок">
                                        <Grid>
                                            <Image Source="{Binding Image}" Stretch="UniformToFill" Opacity="0.86" />
                                            <Border VerticalAlignment="Bottom" Height="26" Background="#E6171A20">
                                                <StackPanel Orientation="Horizontal" Margin="7,0" VerticalAlignment="Center">
                                                    <Border x:Name="LabelBadge" Width="20" Height="20" CornerRadius="10" Background="{DynamicResource AccentBrush}">
                                                        <Grid>
                                                            <TextBlock x:Name="LabelText" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="11" FontWeight="Bold" Text="{Binding DisplayLabel}" />
                                                            <Path x:Name="SentMark" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Width="11" Height="8" Stretch="Uniform"
                                                                  Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M1,4.5 L4,7.5 L10,1.5" />
                                                        </Grid>
                                                    </Border>
                                                    <Path Width="10" Height="10" Margin="7,0,4,0" Stroke="#AEB8C7" StrokeThickness="1.2" StrokeLineJoin="Round" Data="M1,1 L9,1 L9,7 L5,7 L2,9 L2,7 L1,7 Z" />
                                                    <TextBlock Foreground="#DCE3ED" FontSize="11" Text="{Binding NoteCount}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="DeleteButton" Style="{StaticResource CardCloseButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0" Opacity="0" Click="OnRemoveCaptureClick" Tag="{Binding}" ToolTip="Удалить">
                                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M1,1 L9,9 M9,1 L1,9" />
                                    </Button>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <!-- Sent captures stay in the strip, dimmed and with a check instead of a letter; hover and
                                     selection are declared after this trigger so they still light the card up. The dimming
                                     sits on the thumbnail and its badge, not on the card, so the delete button that appears
                                     on hover stays as bright as on any other capture. -->
                                <DataTrigger Binding="{Binding IsSent}" Value="True">
                                    <Setter TargetName="ThumbContent" Property="Opacity" Value="0.45" />
                                    <Setter TargetName="ThumbCard" Property="BorderBrush" Value="#333C49" />
                                    <Setter TargetName="LabelBadge" Property="Background" Value="#4A5563" />
                                    <Setter TargetName="LabelText" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="SentMark" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=ThumbCard}" Value="True">
                                    <Setter TargetName="ThumbCard" Property="BorderBrush" Value="#718096" />
                                    <Setter TargetName="DeleteButton" Property="Opacity" Value="1" />
                                    <DataTrigger.EnterActions><BeginStoryboard><Storyboard><ThicknessAnimation Storyboard.TargetName="ThumbCard" Storyboard.TargetProperty="Margin" To="0,4,0,4" Duration="0:0:0.18" DecelerationRatio="0.8" /></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions><BeginStoryboard><Storyboard><ThicknessAnimation Storyboard.TargetName="ThumbCard" Storyboard.TargetProperty="Margin" To="0,0,0,-48" Duration="0:0:0.16" DecelerationRatio="0.8" /></Storyboard></BeginStoryboard></DataTrigger.ExitActions>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=ThumbCard}" Value="True">
                                    <Setter TargetName="ThumbCard" Property="Margin" Value="0,4,0,4" />
                                    <Setter TargetName="DeleteButton" Property="Opacity" Value="1" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="ThumbCard" Property="Margin" Value="0,4,0,4" />
                                    <Setter TargetName="ThumbCard" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
            </ListBox>

            <Button Grid.Row="2" Style="{StaticResource StackButton}" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}" Click="OnCaptureClick">
                <StackPanel Orientation="Horizontal">
                    <Path Stretch="Uniform" Width="16" Height="14" Margin="0,0,7,0" Stroke="White" StrokeThickness="1.6" StrokeLineJoin="Round" Data="M2,5 L2,3 L6,3 L7,1.5 L11,1.5 L12,3 L16,3 L16,13 L2,13 Z M9,5 A3,3 0 1 0 9,11 A3,3 0 1 0 9,5" />
                    <TextBlock Text="Новый снимок" FontWeight="SemiBold" />
                </StackPanel>
            </Button>

            <Grid Grid.Row="3" Margin="0" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                <Button x:Name="TargetButton" Height="36" Style="{StaticResource StackButton}" HorizontalContentAlignment="Left" Click="OnTargetClick" ToolTip="Получатель">
                    <DockPanel LastChildFill="True">
                        <Ellipse DockPanel.Dock="Left" Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0" />
                        <Path DockPanel.Dock="Right" Width="8" Height="5" Margin="8,0,0,0" Fill="#AEB8C7" Data="M0,0 L4,4 L8,0 Z" />
                        <TextBlock x:Name="TargetCaption" VerticalAlignment="Center" Foreground="#EEF2F8" FontSize="12" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Button>
                <Button x:Name="PasteButton" Grid.Column="1" Margin="5,0,0,0" Style="{StaticResource StackButton}" Padding="9" Click="OnPasteClick" IsEnabled="False" ToolTip="Подготовить и вставить в черновик">
                    <Path Width="14" Height="14" Stroke="White" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M7,13 L7,1 M2,6 L7,1 L12,6" />
                </Button>
            </Grid>
            <!-- One toast at a time: it fades in over the strip footer, carries an optional action and never takes focus. -->
            <Border x:Name="Toast" Grid.Row="4" Margin="2,8,2,0" Padding="8,5" CornerRadius="8" Background="#2B3440" Visibility="Collapsed" Opacity="0">
                <DockPanel LastChildFill="True">
                    <Button x:Name="ToastAction" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="0" VerticalAlignment="Center" Focusable="False"
                            Visibility="Collapsed" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AccentTextBrush}" FontSize="11" Cursor="Hand" Click="OnToastActionClick" />
                    <TextBlock x:Name="ToastText" Foreground="#DCE3ED" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <Grid Grid.Row="5" Margin="2,8,2,0">
                <TextBlock x:Name="StatusText" Visibility="Collapsed" Foreground="#FF9B95" FontSize="11" TextWrapping="Wrap" />
            </Grid>
        </Grid>
    </Border>
    <!-- The left edge of the card resizes the strip: six invisible pixels over the border, right
         where the pointer expects them. The right edge is fixed while dragging, so the strip keeps
         its place at the screen edge. The header drag lives further in and never meets this. -->
    <Thumb x:Name="WidthGrip" HorizontalAlignment="Left" Width="6" Margin="10,22,0,22" Cursor="SizeWE"
           DragStarted="OnWidthDragStarted" DragDelta="OnWidthDragDelta" DragCompleted="OnWidthDragCompleted">
        <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent" /></ControlTemplate></Thumb.Template>
    </Thumb>
    <!-- The bottom left corner takes width and height at once. It is declared after WidthGrip so it
         wins the hit test where the two meet, and it sits on the corner of the visible card, which is
         10 px inside the window because that margin carries the shadow. The cursor is SizeNESW: the
         bottom left corner is dragged along the north-east / south-west diagonal. The window has no
         height of its own (SizeToContent), so the drag changes CaptureList.Height instead.
         The window is not resizable by the system, and the strip has no MaxHeight any more: the
         ceiling comes from the working area of the monitor it is on. -->
    <Thumb x:Name="CornerGrip" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="16" Height="16" Margin="10,0,0,10" Cursor="SizeNESW"
           DragStarted="OnCornerDragStarted" DragDelta="OnCornerDragDelta" DragCompleted="OnCornerDragCompleted">
        <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent" /></ControlTemplate></Thumb.Template>
    </Thumb>
    </Grid>
</Window>
