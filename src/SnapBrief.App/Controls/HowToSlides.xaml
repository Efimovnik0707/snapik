<UserControl x:Class="SnapBrief.App.Controls.HowToSlides"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SnapBrief.App.Controls"
             Focusable="True" IsTabStop="False">
 <UserControl.Resources>
  <!-- The chevrons and the dots are the only buttons of the control; the wizard keeps its own copy
       of this style, because a user control cannot reach the resources of the window it sits in. -->
  <Style x:Key="SlideIconButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
   <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="MinWidth" Value="30"/>
   <Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="0"/>
   <Setter Property="Background" Value="#21262F"/><Setter Property="BorderBrush" Value="#39424F"/>
   <Setter Property="controls:ButtonChrome.HoverBackground" Value="#2A3240"/>
   <Setter Property="controls:ButtonChrome.PressedBackground" Value="#20262F"/>
  </Style>
  <Style x:Key="SlideDotButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
   <Setter Property="Width" Value="16"/><Setter Property="Height" Value="16"/><Setter Property="MinWidth" Value="16"/>
   <Setter Property="MinHeight" Value="16"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="4,0"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="controls:ButtonChrome.HoverBackground" Value="#2A3240"/>
   <Setter Property="controls:ButtonChrome.PressedBackground" Value="#20262F"/>
  </Style>
  <!-- One line of the explanation: a number in a circle and the sentence beside it. The lines come
       one after another and stay, so by the end of the loop the whole list is on screen. -->
  <Style x:Key="CaptionNumber" TargetType="Border">
   <Setter Property="Width" Value="22"/><Setter Property="Height" Value="22"/><Setter Property="CornerRadius" Value="11"/>
   <Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="VerticalAlignment" Value="Top"/>
  </Style>
  <Style x:Key="CaptionNumberText" TargetType="TextBlock">
   <Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#FFFFFF"/>
   <Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="CaptionText" TargetType="TextBlock">
   <Setter Property="FontSize" Value="14"/><Setter Property="LineHeight" Value="20"/><Setter Property="Foreground" Value="#EEF2F8"/>
   <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="12,0,0,0"/><Setter Property="VerticalAlignment" Value="Top"/>
  </Style>
  <Style x:Key="CaptionRow" TargetType="Grid">
   <Setter Property="Margin" Value="0,0,0,10"/>
  </Style>

  <!-- Every slide is one loop of nine seconds that repeats on its own; the control moves on to the
       next slide by a clock of its own. The picture is finished well before the loop ends, and the
       rest of the loop is the pause that makes it readable. -->
  <Storyboard x:Key="Slide1Loop" Duration="0:0:9" RepeatBehavior="Forever">
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SlideProgress" Storyboard.TargetProperty="Width">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:9" Value="478"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="S1Row2" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:1.62" Value="0"/>
    <SplineDoubleKeyFrame KeyTime="0:0:2.07" Value="1" KeySpline="0.25,0.1 0.25,1"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="S1Row2Move" Storyboard.TargetProperty="X">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-8"/><DiscreteDoubleKeyFrame KeyTime="0:0:1.62" Value="-8"/>
    <SplineDoubleKeyFrame KeyTime="0:0:2.07" Value="0" KeySpline="0.25,0.1 0.25,1"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="S1Row3" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:3.06" Value="0"/>
    <SplineDoubleKeyFrame KeyTime="0:0:3.51" Value="1" KeySpline="0.25,0.1 0.25,1"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="S1Row3Move" Storyboard.TargetProperty="X">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-8"/><DiscreteDoubleKeyFrame KeyTime="0:0:3.06" Value="-8"/>
    <SplineDoubleKeyFrame KeyTime="0:0:3.51" Value="0" KeySpline="0.25,0.1 0.25,1"/>
   </DoubleAnimationUsingKeyFrames>
  </Storyboard>

  <Storyboard x:Key="Slide2Loop" Duration="0:0:9" RepeatBehavior="Forever">
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SlideProgress" Storyboard.TargetProperty="Width">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:9" Value="478"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="S2Row2" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:1.62" Value="0"/>
    <SplineDoubleKeyFrame KeyTime="0:0:2.07" Value="1" KeySpline="0.25,0.1 0.25,1"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="S2Row2Move" Storyboard.TargetProperty="X">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-8"/><DiscreteDoubleKeyFrame KeyTime="0:0:1.62" Value="-8"/>
    <SplineDoubleKeyFrame KeyTime="0:0:2.07" Value="0" KeySpline="0.25,0.1 0.25,1"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="S2Row3" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:3.06" Value="0"/>
    <SplineDoubleKeyFrame KeyTime="0:0:3.51" Value="1" KeySpline="0.25,0.1 0.25,1"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="S2Row3Move" Storyboard.TargetProperty="X">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-8"/><DiscreteDoubleKeyFrame KeyTime="0:0:3.06" Value="-8"/>
    <SplineDoubleKeyFrame KeyTime="0:0:3.51" Value="0" KeySpline="0.25,0.1 0.25,1"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="S2Row4" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:5.04" Value="0"/>
    <SplineDoubleKeyFrame KeyTime="0:0:5.49" Value="1" KeySpline="0.25,0.1 0.25,1"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="S2Row4Move" Storyboard.TargetProperty="X">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-8"/><DiscreteDoubleKeyFrame KeyTime="0:0:5.04" Value="-8"/>
    <SplineDoubleKeyFrame KeyTime="0:0:5.49" Value="0" KeySpline="0.25,0.1 0.25,1"/>
   </DoubleAnimationUsingKeyFrames>
  </Storyboard>

  <Storyboard x:Key="Slide3Loop" Duration="0:0:9" RepeatBehavior="Forever">
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SlideProgress" Storyboard.TargetProperty="Width">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:9" Value="478"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="S3Row2" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:1.62" Value="0"/>
    <SplineDoubleKeyFrame KeyTime="0:0:2.07" Value="1" KeySpline="0.25,0.1 0.25,1"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="S3Row2Move" Storyboard.TargetProperty="X">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-8"/><DiscreteDoubleKeyFrame KeyTime="0:0:1.62" Value="-8"/>
    <SplineDoubleKeyFrame KeyTime="0:0:2.07" Value="0" KeySpline="0.25,0.1 0.25,1"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="S3Row3" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:3.06" Value="0"/>
    <SplineDoubleKeyFrame KeyTime="0:0:3.51" Value="1" KeySpline="0.25,0.1 0.25,1"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="S3Row3Move" Storyboard.TargetProperty="X">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-8"/><DiscreteDoubleKeyFrame KeyTime="0:0:3.06" Value="-8"/>
    <SplineDoubleKeyFrame KeyTime="0:0:3.51" Value="0" KeySpline="0.25,0.1 0.25,1"/>
   </DoubleAnimationUsingKeyFrames>
  </Storyboard>

  <Storyboard x:Key="Slide4Loop" Duration="0:0:9" RepeatBehavior="Forever">
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SlideProgress" Storyboard.TargetProperty="Width">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:9" Value="478"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="S4Row2" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:1.62" Value="0"/>
    <SplineDoubleKeyFrame KeyTime="0:0:2.07" Value="1" KeySpline="0.25,0.1 0.25,1"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="S4Row2Move" Storyboard.TargetProperty="X">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-8"/><DiscreteDoubleKeyFrame KeyTime="0:0:1.62" Value="-8"/>
    <SplineDoubleKeyFrame KeyTime="0:0:2.07" Value="0" KeySpline="0.25,0.1 0.25,1"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="S4Row3" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:3.06" Value="0"/>
    <SplineDoubleKeyFrame KeyTime="0:0:3.51" Value="1" KeySpline="0.25,0.1 0.25,1"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="S4Row3Move" Storyboard.TargetProperty="X">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-8"/><DiscreteDoubleKeyFrame KeyTime="0:0:3.06" Value="-8"/>
    <SplineDoubleKeyFrame KeyTime="0:0:3.51" Value="0" KeySpline="0.25,0.1 0.25,1"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="S4Row4" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:5.04" Value="0"/>
    <SplineDoubleKeyFrame KeyTime="0:0:5.49" Value="1" KeySpline="0.25,0.1 0.25,1"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="S4Row4Move" Storyboard.TargetProperty="X">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-8"/><DiscreteDoubleKeyFrame KeyTime="0:0:5.04" Value="-8"/>
    <SplineDoubleKeyFrame KeyTime="0:0:5.49" Value="0" KeySpline="0.25,0.1 0.25,1"/>
   </DoubleAnimationUsingKeyFrames>
  </Storyboard>
 </UserControl.Resources>

 <StackPanel Width="480">
  <!-- The heading of the step and the name of the slide under it: the step says what this is, the
       line under it says which of the four is on screen. -->
  <StackPanel Margin="0,0,0,12">
   <TextBlock Text="Как пользоваться" FontSize="24" FontWeight="SemiBold" LineHeight="30" Foreground="#EEF2F8" Margin="0,0,0,4"/>
   <TextBlock x:Name="SlideTitle" FontSize="14" LineHeight="21" Foreground="#A9B4C2"/>
  </StackPanel>

  <Border Width="480" Height="210" CornerRadius="12" Background="#12161D" BorderBrush="#2A3240" BorderThickness="1"
          ClipToBounds="True" Margin="0,0,0,16">
   <Grid>
    <Grid Margin="12,0">
     <controls:CaptureSceneSmall x:Name="Scene1" VerticalAlignment="Center"/>
     <Grid x:Name="Scene2" Visibility="Collapsed"/>
     <Grid x:Name="Scene3" Visibility="Collapsed"/>
     <Grid x:Name="Scene4" Visibility="Collapsed"/>
    </Grid>
    <!-- How much of the loop is left, along the bottom edge of the scene. -->
    <Grid Height="2" VerticalAlignment="Bottom">
     <Rectangle Fill="#2A3240"/>
     <Rectangle x:Name="SlideProgress" Width="0" HorizontalAlignment="Left" Fill="{DynamicResource AccentBrush}" Opacity="0.7"/>
    </Grid>
   </Grid>
  </Border>

  <Grid Margin="0,0,0,16">
   <StackPanel x:Name="SlideCaptions1">
    <Grid Style="{StaticResource CaptionRow}">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource CaptionNumber}"><TextBlock Text="1" Style="{StaticResource CaptionNumberText}"/></Border>
     <TextBlock Grid.Column="1" Style="{StaticResource CaptionText}" Text="Выдели область экрана, которую хочешь снять."/>
    </Grid>
    <Grid x:Name="S1Row2" Style="{StaticResource CaptionRow}" Opacity="0">
     <Grid.RenderTransform><TranslateTransform x:Name="S1Row2Move" X="-8"/></Grid.RenderTransform>
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource CaptionNumber}"><TextBlock Text="2" Style="{StaticResource CaptionNumberText}"/></Border>
     <TextBlock Grid.Column="1" Style="{StaticResource CaptionText}" Text="Поставь комментарии там, где удобно — сколько нужно."/>
    </Grid>
    <Grid x:Name="S1Row3" Opacity="0">
     <Grid.RenderTransform><TranslateTransform x:Name="S1Row3Move" X="-8"/></Grid.RenderTransform>
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource CaptionNumber}"><TextBlock Text="3" Style="{StaticResource CaptionNumberText}"/></Border>
     <TextBlock Grid.Column="1" Style="{StaticResource CaptionText}" Text="Ctrl+V в любой чат — картинка и комментарии вставятся вместе."/>
    </Grid>
   </StackPanel>

   <StackPanel x:Name="SlideCaptions2" Visibility="Collapsed">
    <Grid Style="{StaticResource CaptionRow}">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource CaptionNumber}"><TextBlock Text="1" Style="{StaticResource CaptionNumberText}"/></Border>
     <TextBlock Grid.Column="1" Style="{StaticResource CaptionText}" Text="Сделай несколько снимков подряд."/>
    </Grid>
    <Grid x:Name="S2Row2" Style="{StaticResource CaptionRow}" Opacity="0">
     <Grid.RenderTransform><TranslateTransform x:Name="S2Row2Move" X="-8"/></Grid.RenderTransform>
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource CaptionNumber}"><TextBlock Text="2" Style="{StaticResource CaptionNumberText}"/></Border>
     <TextBlock Grid.Column="1" Style="{StaticResource CaptionText}" Text="Все они собираются в ленту у края экрана."/>
    </Grid>
    <Grid x:Name="S2Row3" Style="{StaticResource CaptionRow}" Opacity="0">
     <Grid.RenderTransform><TranslateTransform x:Name="S2Row3Move" X="-8"/></Grid.RenderTransform>
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource CaptionNumber}"><TextBlock Text="3" Style="{StaticResource CaptionNumberText}"/></Border>
     <TextBlock Grid.Column="1" Style="{StaticResource CaptionText}" Text="У каждого — свои комментарии."/>
    </Grid>
    <Grid x:Name="S2Row4" Opacity="0">
     <Grid.RenderTransform><TranslateTransform x:Name="S2Row4Move" X="-8"/></Grid.RenderTransform>
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource CaptionNumber}"><TextBlock Text="4" Style="{StaticResource CaptionNumberText}"/></Border>
     <TextBlock Grid.Column="1" Style="{StaticResource CaptionText}" Text="Ctrl+V — и вся пачка уходит одним сообщением."/>
    </Grid>
   </StackPanel>

   <StackPanel x:Name="SlideCaptions3" Visibility="Collapsed">
    <Grid Style="{StaticResource CaptionRow}">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource CaptionNumber}"><TextBlock Text="1" Style="{StaticResource CaptionNumberText}"/></Border>
     <TextBlock Grid.Column="1" Style="{StaticResource CaptionText}" Text="Каждый снимок хранит свои комментарии."/>
    </Grid>
    <Grid x:Name="S3Row2" Style="{StaticResource CaptionRow}" Opacity="0">
     <Grid.RenderTransform><TranslateTransform x:Name="S3Row2Move" X="-8"/></Grid.RenderTransform>
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource CaptionNumber}"><TextBlock Text="2" Style="{StaticResource CaptionNumberText}"/></Border>
     <TextBlock Grid.Column="1" Style="{StaticResource CaptionText}" Text="Клик по снимку в ленте — он открывается снова, всё на месте."/>
    </Grid>
    <Grid x:Name="S3Row3" Opacity="0">
     <Grid.RenderTransform><TranslateTransform x:Name="S3Row3Move" X="-8"/></Grid.RenderTransform>
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource CaptionNumber}"><TextBlock Text="3" Style="{StaticResource CaptionNumberText}"/></Border>
     <TextBlock Grid.Column="1" Style="{StaticResource CaptionText}" Text="Поправь и закрой — изменения останутся в ленте."/>
    </Grid>
   </StackPanel>

   <StackPanel x:Name="SlideCaptions4" Visibility="Collapsed">
    <Grid Style="{StaticResource CaptionRow}">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource CaptionNumber}"><TextBlock Text="1" Style="{StaticResource CaptionNumberText}"/></Border>
     <TextBlock Grid.Column="1" Style="{StaticResource CaptionText}" Text="Лента живёт, пока открыта. Закроешь — снимки удалятся."/>
    </Grid>
    <Grid x:Name="S4Row2" Style="{StaticResource CaptionRow}" Opacity="0">
     <Grid.RenderTransform><TranslateTransform x:Name="S4Row2Move" X="-8"/></Grid.RenderTransform>
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource CaptionNumber}"><TextBlock Text="2" Style="{StaticResource CaptionNumberText}"/></Border>
     <TextBlock Grid.Column="1" Style="{StaticResource CaptionText}" Text="Сохранить — «Сохранить пакет…», или включи автосохранение в папку."/>
    </Grid>
    <Grid x:Name="S4Row3" Style="{StaticResource CaptionRow}" Opacity="0">
     <Grid.RenderTransform><TranslateTransform x:Name="S4Row3Move" X="-8"/></Grid.RenderTransform>
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource CaptionNumber}"><TextBlock Text="3" Style="{StaticResource CaptionNumberText}"/></Border>
     <TextBlock Grid.Column="1" Style="{StaticResource CaptionText}" Text="Мешает — сверни в капсулу, клик разворачивает обратно."/>
    </Grid>
    <Grid x:Name="S4Row4" Opacity="0">
     <Grid.RenderTransform><TranslateTransform x:Name="S4Row4Move" X="-8"/></Grid.RenderTransform>
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource CaptionNumber}"><TextBlock Text="4" Style="{StaticResource CaptionNumberText}"/></Border>
     <TextBlock Grid.Column="1" Style="{StaticResource CaptionText}" Text="Лишний снимок — крестик. Всё сразу — «Очистить»."/>
    </Grid>
   </StackPanel>
  </Grid>

  <!-- The way through the slides by hand: a row of its own above the buttons of the wizard, so that
       nothing lies over the picture. -->
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
   <Button x:Name="PreviousSlideButton" Style="{StaticResource SlideIconButton}" Margin="0,0,14,0"
           Click="OnPreviousSlide" ToolTip="Предыдущий слайд">
    <Path Data="M7,1 L2,6 L7,11" Stroke="#EEF2F8" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
   </Button>
   <Button x:Name="Dot1" Style="{StaticResource SlideDotButton}" Click="OnDot"><Ellipse x:Name="DotMark1" Width="8" Height="8" Fill="#3A4553"/></Button>
   <Button x:Name="Dot2" Style="{StaticResource SlideDotButton}" Click="OnDot"><Ellipse x:Name="DotMark2" Width="8" Height="8" Fill="#3A4553"/></Button>
   <Button x:Name="Dot3" Style="{StaticResource SlideDotButton}" Click="OnDot"><Ellipse x:Name="DotMark3" Width="8" Height="8" Fill="#3A4553"/></Button>
   <Button x:Name="Dot4" Style="{StaticResource SlideDotButton}" Click="OnDot"><Ellipse x:Name="DotMark4" Width="8" Height="8" Fill="#3A4553"/></Button>
   <Button x:Name="NextSlideButton" Style="{StaticResource SlideIconButton}" Margin="14,0,0,0"
           Click="OnNextSlide" ToolTip="Следующий слайд">
    <Path Data="M1,1 L6,6 L1,11" Stroke="#EEF2F8" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
   </Button>
  </StackPanel>
 </StackPanel>
</UserControl>
