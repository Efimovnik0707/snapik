<UserControl x:Class="SnapBrief.App.Controls.HowToSlides"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SnapBrief.App.Controls"
             Focusable="True" IsTabStop="False">
 <UserControl.Resources>
  <!-- The chevrons and the dots are the only buttons of the control; the wizard keeps its own copy
       of this style, because a user control cannot reach the resources of the window it sits in. -->
  <Style x:Key="SlideIconButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
   <Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="MinWidth" Value="28"/>
   <Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="controls:ButtonChrome.HoverBackground" Value="#2A3240"/>
   <Setter Property="controls:ButtonChrome.PressedBackground" Value="#20262F"/>
  </Style>
  <Style x:Key="SlideDotButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
   <Setter Property="Width" Value="16"/><Setter Property="Height" Value="16"/><Setter Property="MinWidth" Value="16"/>
   <Setter Property="MinHeight" Value="16"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="4,0"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="controls:ButtonChrome.HoverBackground" Value="#2A3240"/>
   <Setter Property="controls:ButtonChrome.PressedBackground" Value="#20262F"/>
  </Style>
  <Style x:Key="SlideCaption" TargetType="TextBlock">
   <Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="#EEF2F8"/>
   <Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="Opacity" Value="0"/>
  </Style>

  <!-- Every slide is four phases of 1.2 s, 4.8 s in all, and runs once: the control moves on to the
       next slide when the clock reports it is done, so the four of them go round on their own. -->
  <Storyboard x:Key="Slide1Loop" Duration="0:0:4.8">
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HintKey" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.4"/><LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="1"/><DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="0.4"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HintKeyScale" Storyboard.TargetProperty="ScaleY">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/><LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="0.8"/><LinearDoubleKeyFrame KeyTime="0:0:0.5" Value="1"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HintSelection" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="1"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HintSelection" Storyboard.TargetProperty="Width">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:2.1" Value="150"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HintSelection" Storyboard.TargetProperty="Height">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:2.1" Value="66"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HintNote" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:2.4" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:2.9" Value="1"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HintPaste" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:3.6" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:4" Value="1"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HintArrow" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:3.7" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:4.1" Value="1"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HintChat" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.35"/><DiscreteDoubleKeyFrame KeyTime="0:0:3.6" Value="0.35"/><LinearDoubleKeyFrame KeyTime="0:0:4" Value="1"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HintCaption1" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/><DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="0"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HintCaption2" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="1"/><DiscreteDoubleKeyFrame KeyTime="0:0:2.4" Value="0"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HintCaption3" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:2.4" Value="1"/><DiscreteDoubleKeyFrame KeyTime="0:0:3.6" Value="0"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HintCaption4" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:3.6" Value="1"/>
   </DoubleAnimationUsingKeyFrames>
  </Storyboard>

  <!-- A capture, another capture, the strip fills up to ten, one Ctrl+V sends them all. -->
  <Storyboard x:Key="Slide2Loop" Duration="0:0:4.8">
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PackKey" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.4"/><LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="1"/><DiscreteDoubleKeyFrame KeyTime="0:0:0.9" Value="0.4"/>
    <LinearDoubleKeyFrame KeyTime="0:0:1.4" Value="1"/><DiscreteDoubleKeyFrame KeyTime="0:0:2.1" Value="0.4"/>
    <LinearDoubleKeyFrame KeyTime="0:0:2.6" Value="1"/><DiscreteDoubleKeyFrame KeyTime="0:0:3.4" Value="0.4"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PackKeyScale" Storyboard.TargetProperty="ScaleY">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/><LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="0.8"/><LinearDoubleKeyFrame KeyTime="0:0:0.5" Value="1"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PackCardA" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:0.15" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:0.5" Value="1"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PackCardAMove" Storyboard.TargetProperty="X">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-90"/><DiscreteDoubleKeyFrame KeyTime="0:0:0.15" Value="-90"/>
    <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="0"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PackCardAMove" Storyboard.TargetProperty="Y">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="24"/><DiscreteDoubleKeyFrame KeyTime="0:0:0.15" Value="24"/>
    <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="0"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PackCardB" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:1.35" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:1.7" Value="1"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PackCardBMove" Storyboard.TargetProperty="X">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-90"/><DiscreteDoubleKeyFrame KeyTime="0:0:1.35" Value="-90"/>
    <EasingDoubleKeyFrame KeyTime="0:0:1.7" Value="0"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PackCardBMove" Storyboard.TargetProperty="Y">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="24"/><DiscreteDoubleKeyFrame KeyTime="0:0:1.35" Value="24"/>
    <EasingDoubleKeyFrame KeyTime="0:0:1.7" Value="0"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PackCardC" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:2.55" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:2.9" Value="1"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PackCardCMove" Storyboard.TargetProperty="X">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-90"/><DiscreteDoubleKeyFrame KeyTime="0:0:2.55" Value="-90"/>
    <EasingDoubleKeyFrame KeyTime="0:0:2.9" Value="0"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PackCardD" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:3" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:3.35" Value="1"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PackCardDMove" Storyboard.TargetProperty="X">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-90"/><DiscreteDoubleKeyFrame KeyTime="0:0:3" Value="-90"/>
    <EasingDoubleKeyFrame KeyTime="0:0:3.35" Value="0"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PackCounter" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:2.4" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:3" Value="0.7"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PackPaste" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:3.7" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:4.1" Value="1"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PackArrow" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:3.8" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:4.2" Value="1"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PackChat" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.35"/><DiscreteDoubleKeyFrame KeyTime="0:0:3.6" Value="0.35"/><LinearDoubleKeyFrame KeyTime="0:0:4.1" Value="1"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PackSent" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:4" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:4.4" Value="1"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PackCards" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/><DiscreteDoubleKeyFrame KeyTime="0:0:4" Value="1"/><LinearDoubleKeyFrame KeyTime="0:0:4.4" Value="0.45"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PackCaption1" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/><DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="0"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PackCaption2" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="1"/><DiscreteDoubleKeyFrame KeyTime="0:0:2.4" Value="0"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PackCaption3" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:2.4" Value="1"/><DiscreteDoubleKeyFrame KeyTime="0:0:3.6" Value="0"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PackCaption4" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:3.6" Value="1"/>
   </DoubleAnimationUsingKeyFrames>
  </Storyboard>

  <!-- Frame the spot, drop a marker, write what is wrong, and the numbers travel into the chat. -->
  <Storyboard x:Key="Slide3Loop" Duration="0:0:4.8">
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NoteFrame" Storyboard.TargetProperty="Width">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="104"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NoteFrame" Storyboard.TargetProperty="Height">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="46"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NoteBadge" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:1.45" Value="1"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NoteBadgeScale" Storyboard.TargetProperty="ScaleX">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.7"/><DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="0.7"/>
    <EasingDoubleKeyFrame KeyTime="0:0:1.5" Value="1"><EasingDoubleKeyFrame.EasingFunction><BackEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NoteBadgeScale" Storyboard.TargetProperty="ScaleY">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.7"/><DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="0.7"/>
    <EasingDoubleKeyFrame KeyTime="0:0:1.5" Value="1"><EasingDoubleKeyFrame.EasingFunction><BackEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NotePill" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:2.4" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:2.6" Value="1"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NotePill" Storyboard.TargetProperty="Width">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="24"/><DiscreteDoubleKeyFrame KeyTime="0:0:2.4" Value="24"/><LinearDoubleKeyFrame KeyTime="0:0:2.8" Value="150"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NotePillText" Storyboard.TargetProperty="Width">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:2.8" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:3.3" Value="96"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimation Storyboard.TargetName="NoteCaret" Storyboard.TargetProperty="Opacity"
                    BeginTime="0:0:2.8" Duration="0:0:0.4" From="1" To="0" AutoReverse="True" RepeatBehavior="2x"/>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NoteChatLine1" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:3.6" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:3.9" Value="1"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NoteChatLine2" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:3.75" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:4.05" Value="1"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NoteCaption1" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/><DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="0"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NoteCaption2" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="1"/><DiscreteDoubleKeyFrame KeyTime="0:0:2.4" Value="0"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NoteCaption3" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:2.4" Value="1"/><DiscreteDoubleKeyFrame KeyTime="0:0:3.6" Value="0"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NoteCaption4" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:3.6" Value="1"/>
   </DoubleAnimationUsingKeyFrames>
  </Storyboard>

  <!-- The captures stay, the sent ones go quiet, a new one is bright again, "Clear" empties the strip. -->
  <Storyboard x:Key="Slide4Loop" Duration="0:0:4.8">
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LifeSent" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="1"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LifeCard1" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/><DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="1"/><LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="0.45"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LifeCard2" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/><DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="1"/><LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="0.45"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LifeNewCard" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:2.4" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:2.8" Value="1"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LifeNewMove" Storyboard.TargetProperty="Y">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-40"/><DiscreteDoubleKeyFrame KeyTime="0:0:2.4" Value="-40"/>
    <EasingDoubleKeyFrame KeyTime="0:0:2.8" Value="0"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LifeTrashHot" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:3.6" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:3.8" Value="1"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LifeTrashScale" Storyboard.TargetProperty="ScaleX">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/><DiscreteDoubleKeyFrame KeyTime="0:0:3.6" Value="1"/><LinearDoubleKeyFrame KeyTime="0:0:3.85" Value="1.15"/><LinearDoubleKeyFrame KeyTime="0:0:4.1" Value="1"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LifeTrashScale" Storyboard.TargetProperty="ScaleY">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/><DiscreteDoubleKeyFrame KeyTime="0:0:3.6" Value="1"/><LinearDoubleKeyFrame KeyTime="0:0:3.85" Value="1.15"/><LinearDoubleKeyFrame KeyTime="0:0:4.1" Value="1"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LifeTrashHotScale" Storyboard.TargetProperty="ScaleX">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/><DiscreteDoubleKeyFrame KeyTime="0:0:3.6" Value="1"/><LinearDoubleKeyFrame KeyTime="0:0:3.85" Value="1.15"/><LinearDoubleKeyFrame KeyTime="0:0:4.1" Value="1"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LifeTrashHotScale" Storyboard.TargetProperty="ScaleY">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/><DiscreteDoubleKeyFrame KeyTime="0:0:3.6" Value="1"/><LinearDoubleKeyFrame KeyTime="0:0:3.85" Value="1.15"/><LinearDoubleKeyFrame KeyTime="0:0:4.1" Value="1"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LifeCardsMove" Storyboard.TargetProperty="Y">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:3.9" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:4.35" Value="-24"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LifeCards" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/><DiscreteDoubleKeyFrame KeyTime="0:0:3.9" Value="1"/><LinearDoubleKeyFrame KeyTime="0:0:4.35" Value="0"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LifeCaption1" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/><DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="0"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LifeCaption2" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="1"/><DiscreteDoubleKeyFrame KeyTime="0:0:2.4" Value="0"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LifeCaption3" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:2.4" Value="1"/><DiscreteDoubleKeyFrame KeyTime="0:0:3.6" Value="0"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LifeCaption4" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:3.6" Value="1"/>
   </DoubleAnimationUsingKeyFrames>
  </Storyboard>
 </UserControl.Resources>

 <StackPanel>
  <Grid>
   <!-- One frame for all four drawings: each of them keeps its own 500x200 grid inside the shared
        Viewbox, so a slide can be drawn in round numbers and still fit the 360 of a wizard step. -->
   <Border Background="Transparent" BorderBrush="#2A3240" BorderThickness="1" CornerRadius="12" Padding="8">
    <Viewbox Stretch="Uniform" Height="144">
     <Grid Width="500" Height="200">
      <Canvas x:Name="SlideCanvas1" Width="500" Height="200">
       <Border Canvas.Left="26" Canvas.Top="22" Width="230" Height="140" CornerRadius="8" Background="#1B212B" BorderBrush="#33404F" BorderThickness="1"/>
       <Rectangle Canvas.Left="42" Canvas.Top="40" Width="90" Height="8" RadiusX="4" RadiusY="4" Fill="#2C3746"/>
       <Rectangle Canvas.Left="42" Canvas.Top="56" Width="150" Height="8" RadiusX="4" RadiusY="4" Fill="#242E3B"/>
