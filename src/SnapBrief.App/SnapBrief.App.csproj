<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\SnapBrief.ico</ApplicationIcon>
    <AssemblyName>SnapBrief</AssemblyName>
    <RootNamespace>SnapBrief.App</RootNamespace>
    <Version>1.3.0</Version>
    <Product>SnapBrief</Product>
    <Authors>Nikita Efimov</Authors>
    <Copyright>Copyright (c) 2026 Nikita Efimov</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SnapBrief.Core\SnapBrief.Core.csproj" />
    <ProjectReference Include="..\SnapBrief.Infrastructure\SnapBrief.Infrastructure.csproj" />
    <ProjectReference Include="..\SnapBrief.Windows\SnapBrief.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Content, not EmbeddedResource: MediaPlayer opens files, not pack:// resources. -->
    <Content Include="Assets\Audio\*.mp3" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup><Compile Remove="MainWindow.xaml.cs" /><Page Remove="MainWindow.xaml" /></ItemGroup>
</Project>
