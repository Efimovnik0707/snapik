<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\SnapBrief.ico</ApplicationIcon>
    <AssemblyName>SnapBrief</AssemblyName>
    <RootNamespace>SnapBrief.App</RootNamespace>
    <Version>1.0.0</Version>
    <Product>SnapBrief</Product>
    <Authors>Nikita Efimov</Authors>
    <Copyright>Copyright (c) 2026 Nikita Efimov</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SnapBrief.Core\SnapBrief.Core.csproj" />
    <ProjectReference Include="..\SnapBrief.Infrastructure\SnapBrief.Infrastructure.csproj" />
    <ProjectReference Include="..\SnapBrief.Windows\SnapBrief.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\Audio\camera-shutter.wav" LogicalName="SnapBrief.App.Assets.Audio.camera-shutter.wav" />
    <EmbeddedResource Include="Assets\Audio\camera-dial-click.wav" LogicalName="SnapBrief.App.Assets.Audio.camera-dial-click.wav" />
  </ItemGroup>
  <ItemGroup><Compile Remove="MainWindow.xaml.cs" /><Page Remove="MainWindow.xaml" /></ItemGroup>
</Project>
