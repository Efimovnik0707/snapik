<Window x:Class="SnapBrief.App.OverlayEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SnapBrief.App.Controls"
        xmlns:local="clr-namespace:SnapBrief.App"
        Title="SnapBrief — Захват и разметка" AutomationProperties.Name="SnapBrief — Захват и разметка"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False" Background="#0A0D12"
        ShowInTaskbar="False" Topmost="True" Cursor="Cross"
        KeyDown="OnWindowKeyDown" MouseLeftButtonDown="OnWindowMouseDown"
        MouseMove="OnWindowMouseMove" MouseLeftButtonUp="OnWindowMouseUp">
    <Window.Resources>
        <!-- Name plus a key capsule, in the dark of the popover. The letter is carried by Uid of the
             button, filled by the code out of EditorShortcuts, so the panel keeps no letters of its
             own. Uid and not an attached property of ours: a path with a prefix
             ("(local:EditorShortcuts.ShortcutKey)") is resolved by the parser context, which a style
             of a resource dictionary no longer has by the time the tooltip is built, and the capsule
             stays empty without a single line in the binding trace. -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" /><Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Placement" Value="Bottom" /><Setter Property="VerticalOffset" Value="7" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
                <Border Background="#F2171A20" BorderBrush="#394352" BorderThickness="1" CornerRadius="9" Padding="9,6" TextElement.Foreground="#EEF2F8">
                    <StackPanel Orientation="Horizontal">
                        <ContentPresenter VerticalAlignment="Center" />
                        <Border x:Name="KeyCap" Margin="9,0,0,0" Padding="6,1" VerticalAlignment="Center" CornerRadius="5" Background="#252C36" BorderBrush="#465366" BorderThickness="1">
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#B9C3D1" Text="{Binding PlacementTarget.Uid, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Border>
                    </StackPanel>
                </Border>
                <ControlTemplate.Triggers>
                    <DataTrigger Binding="{Binding PlacementTarget.Uid, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                        <Setter TargetName="KeyCap" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding PlacementTarget.Uid, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}">
                        <Setter TargetName="KeyCap" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="OverlayTool" TargetType="ToggleButton">
            <Setter Property="ToolTipService.InitialShowDelay" Value="150" />
            <Setter Property="Width" Value="36" /><Setter Property="Height" Value="36" /><Setter Property="Margin" Value="2,0" />
            <Setter Property="Foreground" Value="#D9DEE8" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
                <Border x:Name="B" CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#29303A" /></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource AccentSoftBrush}" /><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="Foreground" Value="White" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource FocusBrush}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="OverlayButton" TargetType="Button">
            <Setter Property="ToolTipService.InitialShowDelay" Value="150" />
            <Setter Property="Height" Value="36" /><Setter Property="MinWidth" Value="36" /><Setter Property="Padding" Value="11,0" />
            <Setter Property="Margin" Value="2,0" /><Setter Property="Foreground" Value="#EEF2F8" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="B" CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#29303A" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource FocusBrush}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="StrokeSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
                <Grid Background="Transparent">
                    <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}">
                        <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" CornerRadius="2" Background="{DynamicResource AccentBrush}"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb Width="16" Height="16"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="#EEF2F8" Stroke="#8193AB" StrokeThickness="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" CornerRadius="2" Background="#465366"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
                    </Track>
                </Grid>
                <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="Root">
        <Image x:Name="DesktopImage" Stretch="Fill" />
        <Path x:Name="Shade" Fill="#A20A0D12" IsHitTestVisible="False" />
        <Canvas x:Name="EditorLayer">
            <Border x:Name="CropBorder" Visibility="Collapsed" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" Background="Transparent">
                <controls:AnnotationCanvas x:Name="Surface" ImagePadding="0" Tool="Rectangle"
                                           AnnotationCreated="OnAnnotationCreated" SelectionChanged="OnSelectionChanged"
                                           AnnotationActivated="OnAnnotationActivated"
                                           AnnotationChanged="OnAnnotationChanged" CropRequested="OnCropRequested" />
            </Border>
        </Canvas>
        <Canvas x:Name="CaptureHandleLayer" />
        <Canvas x:Name="ChipLayer" IsHitTestVisible="True" />

        <Border x:Name="Hint" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0" Padding="13,8"
                Background="#E8171A20" CornerRadius="10">
            <TextBlock Foreground="White" FontSize="13" Text="Выделите область · Esc отменяет" />
        </Border>

        <Border x:Name="ShotNoteChip" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Width="250"
                Padding="8" CornerRadius="12" Background="#F2171A20">
            <StackPanel>
                <Grid>
                    <TextBlock x:Name="ShotLabel" VerticalAlignment="Center" Foreground="#9AA7B8" FontSize="11" FontWeight="SemiBold" />
                    <Button HorizontalAlignment="Right" Width="25" Height="25" Padding="7" Background="Transparent" BorderThickness="0" Click="OnCloseShotNoteClick" ToolTip="Удалить комментарий">
                        <Path Stroke="#D9DEE8" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M1,1 L9,9 M9,1 L1,9" />
                    </Button>
                </Grid>
                <TextBox x:Name="ShotNoteBox" Margin="0,5,0,0" MinHeight="34" MaxHeight="92" AcceptsReturn="True" TextWrapping="Wrap"
                         Background="#262B34" Foreground="White" BorderBrush="#3A424E" CaretBrush="White" SelectionBrush="{DynamicResource AccentBrush}"
                         TextChanged="OnShotNoteChanged" />
            </StackPanel>
        </Border>

        <Border x:Name="Toolbar" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                Padding="7" CornerRadius="16" Background="#F2171A20">
            <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="5" Opacity="0.45" /></Border.Effect>
            <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="SelectTool" Style="{StaticResource OverlayTool}" Tag="Select" Click="OnToolClick">
                    <Path Width="16" Height="16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.7" StrokeLineJoin="Round" Data="M2,1 L14,9 L9,10 L7,15 Z" />
                </ToggleButton>
                <ToggleButton x:Name="RectangleTool" IsChecked="True" Style="{StaticResource OverlayTool}" Tag="Rectangle" Click="OnToolClick">
                    <Path Width="16" Height="16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.7" Data="M2,3 L14,3 L14,13 L2,13 Z" />
                </ToggleButton>
                <ToggleButton x:Name="ArrowTool" Style="{StaticResource OverlayTool}" Tag="Arrow" Click="OnToolClick">
                    <Path Width="17" Height="17" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M2,15 L15,2 M9,2 L15,2 L15,8" />
                </ToggleButton>
                <Button Style="{StaticResource OverlayButton}" Width="23" MinWidth="23" Padding="6" x:Name="ArrowOptionsButton" Click="OnArrowOptionsClick"><Path Width="9" Height="5" Stroke="#D9DEE8" StrokeThickness="1.5" Data="M1,1 L4.5,4 L8,1"/></Button>
                <ToggleButton x:Name="PenTool" Visibility="Collapsed" Style="{StaticResource OverlayTool}" Tag="Pen" Click="OnToolClick">
                    <Path Width="16" Height="16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.7" StrokeLineJoin="Round" Data="M2,14 C5,12 5,8 8,7 M8,7 L13,2 L15,4 L10,9 Z" />
                </ToggleButton>
                <ToggleButton x:Name="HighlightTool" Visibility="Collapsed" Style="{StaticResource OverlayTool}" Tag="Highlight" Click="OnToolClick">
                    <Path Width="16" Height="16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.7" StrokeLineJoin="Round" Data="M2,11 L10,3 L14,7 L6,15 L2,15 Z" />
                </ToggleButton>
                <ToggleButton x:Name="TextTool" Style="{StaticResource OverlayTool}" Tag="Text" Click="OnToolClick">
                    <Path Width="16" Height="16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.7" Data="M2,2 L14,2 M8,2 L8,14 M5,14 L11,14" />
                </ToggleButton>
                <ToggleButton x:Name="ConcealTool" Visibility="Collapsed" Style="{StaticResource OverlayTool}" Tag="Conceal" Click="OnToolClick">
                    <Path Width="16" Height="16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.7" Data="M1,8 C4,3 12,3 15,8 C12,13 4,13 1,8 Z M3,15 L14,1" />
                </ToggleButton>
                <ToggleButton x:Name="BlurTool" Style="{StaticResource OverlayTool}" Tag="Blur" Click="OnToolClick">
                    <Path Width="16" Height="16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.4" Data="M2,4 L5,2 L8,4 L11,2 L14,4 M2,8 L5,6 L8,8 L11,6 L14,8 M2,12 L5,10 L8,12 L11,10 L14,12" />
                </ToggleButton>
                <ToggleButton x:Name="CropTool" Style="{StaticResource OverlayTool}" Tag="Crop" Click="OnToolClick">
                    <Path Width="16" Height="16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.7" StrokeStartLineCap="Round" Data="M4,1 L4,12 L15,12 M1,4 L12,4 L12,15" />
                </ToggleButton>
                <Button x:Name="AppearanceButton" Style="{StaticResource OverlayButton}" Click="OnColorClick" ToolTip="Цвет и толщина" AutomationProperties.Name="{local:UiText Цвет и толщина}">
                    <StackPanel Orientation="Horizontal"><Ellipse x:Name="ColorSwatch" Width="16" Height="16" Fill="#2F8CFF" Stroke="#D9DEE8" StrokeThickness="1"/><TextBlock x:Name="AppearanceValue" Text="4 px" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
                </Button>
                <Button x:Name="ThicknessButton" Visibility="Collapsed" Style="{StaticResource OverlayButton}" Click="OnThicknessClick" ToolTip="Толщина" Content="4 px" />
                <Button x:Name="MoreToolsButton" Style="{StaticResource OverlayButton}" Click="OnMoreToolsClick" ToolTip="Ещё инструменты" Content="•••" />
                <Button x:Name="CommentToolButton" Style="{StaticResource OverlayButton}" Click="OnCommentClick">
                    <Path Width="16" Height="16" Stroke="#D9DEE8" StrokeThickness="1.6" StrokeLineJoin="Round" Data="M2,2 L14,2 L14,11 L8,11 L4,15 L4,11 L2,11 Z" />
                </Button>
                <Button x:Name="ShortcutSheetButton" Style="{StaticResource OverlayButton}" Width="30" MinWidth="30" Padding="0" FontWeight="SemiBold" Content="?" Click="OnShortcutSheetClick" ToolTip="Сочетания клавиш" AutomationProperties.Name="{local:UiText Сочетания клавиш}" />
                <Popup x:Name="ShortcutSheetPopup" PlacementTarget="{Binding ElementName=ShortcutSheetButton}" Placement="Bottom" VerticalOffset="8" AllowsTransparency="True" StaysOpen="False">
                    <Border Padding="18" Background="#171A20" BorderBrush="#394352" BorderThickness="1" CornerRadius="14" TextElement.Foreground="#EEF2F8" Cursor="Arrow">
                        <StackPanel>
                            <TextBlock Text="Сочетания клавиш" FontWeight="SemiBold" Margin="0,0,0,13" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="34" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel x:Name="SheetTools"><TextBlock Text="Инструменты" Foreground="#8F9AAA" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,7" /></StackPanel>
                                <StackPanel x:Name="SheetActions" Grid.Column="2"><TextBlock Text="Действия" Foreground="#8F9AAA" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,7" /></StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Popup>
                <Border Width="1" Height="22" Margin="7,7" Background="#3A424E" />
                <Button x:Name="UndoButton" Style="{StaticResource OverlayButton}" Click="OnUndoClick"><Path Width="16" Height="16" Stroke="#D9DEE8" StrokeThickness="1.7" Data="M7,3 L2,7 L7,11 M3,7 L10,7 C14,7 15,10 15,13" /></Button>
                <Button x:Name="RedoButton" Style="{StaticResource OverlayButton}" Click="OnRedoClick"><Path Width="16" Height="16" Stroke="#D9DEE8" StrokeThickness="1.7" Data="M9,3 L14,7 L9,11 M13,7 L6,7 C2,7 1,10 1,13" /></Button>
                <Button x:Name="SaveImageButton" Style="{StaticResource OverlayButton}" Click="OnSaveImageClick" AutomationProperties.Name="{local:UiText Сохранить на компьютер}">
                    <Path Width="17" Height="17" Stroke="#D9DEE8" StrokeThickness="1.6" StrokeLineJoin="Round" Data="M2,1 L12,1 L16,5 L16,16 L2,16 Z M5,1 L5,6 L12,6 L12,1 M5,16 L5,10 L13,10 L13,16" />
                </Button>
                <Button x:Name="DoneButton" Style="{StaticResource OverlayButton}" Click="OnDoneClick" Background="{DynamicResource AccentBrush}" FontWeight="SemiBold" Content="Готово" />
            </StackPanel>
        </Border>
        <Popup x:Name="AppearancePopup" PlacementTarget="{Binding ElementName=AppearanceButton}" Placement="Bottom" VerticalOffset="8" AllowsTransparency="True" StaysOpen="False" Closed="OnAppearanceClosed">
            <Border Width="280" Padding="18" Background="#171A20" BorderBrush="#394352" BorderThickness="1" CornerRadius="14" TextElement.Foreground="#EEF2F8" Cursor="Arrow" PreviewKeyDown="OnAppearanceKeyDown">
                <StackPanel>
                    <Grid Margin="0,0,0,14"><TextBlock Text="Цвет" FontWeight="SemiBold"/><Button HorizontalAlignment="Right" Width="22" MinWidth="22" Height="22" Padding="5" Style="{StaticResource OverlayButton}" Click="OnCloseAppearance" ToolTip="Закрыть"><Path Stroke="#D9DEE8" StrokeThickness="1.5" Data="M1,1 L9,9 M9,1 L1,9"/></Button></Grid>
                    <WrapPanel x:Name="ColorPalette" Margin="-3,0,-3,10"/>
                    <TextBox x:Name="ColorHex" Text="#2F8CFF" MaxLength="7" Background="#252C36" Foreground="#EEF2F8" CaretBrush="White" BorderBrush="#465366" Padding="9,6" LostKeyboardFocus="OnHexLostFocus" PreviewKeyDown="OnHexKeyDown" AutomationProperties.Name="{local:UiText Цвет HEX}"/>
                    <Grid Margin="0,18,0,8"><TextBlock Text="Толщина" FontWeight="SemiBold"/><TextBlock x:Name="StrokeValue" HorizontalAlignment="Right"/></Grid>
                    <Slider x:Name="StrokeSlider" Style="{StaticResource StrokeSliderStyle}" Minimum="1" Maximum="16" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" ValueChanged="OnStrokeChanged" AutomationProperties.Name="{local:UiText Толщина линии}"/>
                    <Border Background="#222933" CornerRadius="7" Height="36" Margin="0,12,0,0"><Line x:Name="StrokePreview" X1="15" Y1="18" X2="225" Y2="18" Stroke="#2F8CFF" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Border>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
