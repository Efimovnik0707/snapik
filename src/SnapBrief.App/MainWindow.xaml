<Window x:Class="SnapBrief.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SnapBrief.App"
        xmlns:controls="clr-namespace:SnapBrief.App.Controls"
        Title="SnapBrief" Width="1260" Height="820" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="OnFileDrop"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <Style x:Key="ToolbarSeparator" TargetType="Separator">
            <Setter Property="Width" Value="1" /><Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="7,0" /><Setter Property="Background" Value="{StaticResource LineBrush}" />
        </Style>
        <DataTemplate DataType="{x:Type local:AnnotationItem}">
            <Border x:Name="NoteCard" Margin="0,0,0,8" Padding="10" CornerRadius="9" BorderThickness="1" BorderBrush="{StaticResource LineBrush}" Background="#FBFCFE">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="28" Height="24" CornerRadius="6" Background="#172033" VerticalAlignment="Top">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="11" FontWeight="SemiBold" Text="{Binding Label}" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBox x:Name="AnnotationTextBox" Margin="0,0,0,6" Visibility="Collapsed"
                                 Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" ToolTip="Текст на изображении" />
                        <TextBox MinHeight="54" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding}" GotKeyboardFocus="OnAnnotationNoteFocus"
                                 ToolTip="Комментарий к этой отметке" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="NoteCard" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter TargetName="NoteCard" Property="Background" Value="{StaticResource SelectedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Text">
                    <Setter TargetName="AnnotationTextBox" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource PaperBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
            <RowDefinition Height="126" />
            <RowDefinition Height="31" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <DockPanel Margin="10,0">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource BaseButton}" Click="OnCaptureClick" ToolTip="Сделать снимок (Ctrl+Alt+S)">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="17" Height="17" Margin="0,0,7,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeLineJoin="Round"
                                  Data="M2,5 L2,3 L6,3 L7.2,1.5 L11.8,1.5 L13,3 L17,3 L17,14 L2,14 Z M9.5,5 A3.5,3.5 0 1 0 9.5,12 A3.5,3.5 0 1 0 9.5,5" />
                            <TextBlock Text="Снимок" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BaseButton}" Click="OnImportFileClick" ToolTip="Импортировать PNG или JPEG">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="16" Height="16" Margin="0,0,7,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M2,12 L2,15 L15,15 L15,12 M8.5,1 L8.5,11 M4.5,7 L8.5,11 L12.5,7" />
                            <TextBlock Text="Импорт" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BaseButton}" Click="OnImportClipboardClick" ToolTip="Вставить изображение из буфера">
                        <Path Width="16" Height="16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeLineJoin="Round" Data="M5,2 L5,1 L11,1 L11,2 M3,3 L13,3 L13,16 L3,16 Z M5,6 L11,6 M5,9 L11,9 M5,12 L9,12" />
                    </Button>
                    <Button Style="{StaticResource BaseButton}" Click="OnSettingsClick" ToolTip="Настройки горячих клавиш">
                        <Path Width="16" Height="16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeLineJoin="Round" Data="M8,1 L9,3 L12,4 L14,3 L16,6 L14,8 L14,11 L16,13 L14,16 L11,14 L8,15 L7,17 L3,16 L3,13 L1,11 L2,8 L1,6 L4,3 L6,4 Z M8.5,6 A3,3 0 1 0 8.5,12 A3,3 0 1 0 8.5,6" />
                    </Button>
                    <Separator Style="{StaticResource ToolbarSeparator}" />

                    <ToggleButton x:Name="SelectTool" Style="{StaticResource ToolButton}" IsChecked="True" Click="OnToolClick" Tag="Select" ToolTip="Выбор (V)">
                        <Path Width="17" Height="17" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Fill="Transparent" StrokeThickness="1.7" StrokeLineJoin="Round" Data="M2,1 L14,9 L9,10 L7,15 Z" />
                    </ToggleButton>
                    <ToggleButton x:Name="ArrowTool" Style="{StaticResource ToolButton}" Click="OnToolClick" Tag="Arrow" ToolTip="Стрелка (A)">
                        <Path Width="18" Height="18" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M2,16 L16,2 M9,2 L16,2 L16,9" />
                    </ToggleButton>
                    <ToggleButton x:Name="RectangleTool" Style="{StaticResource ToolButton}" Click="OnToolClick" Tag="Rectangle" ToolTip="Рамка (R)">
                        <Path Width="17" Height="17" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.7" Data="M2,3 L15,3 L15,14 L2,14 Z" />
                    </ToggleButton>
                    <ToggleButton x:Name="PenTool" Style="{StaticResource ToolButton}" Click="OnToolClick" Tag="Pen" ToolTip="Перо (P)">
                        <Path Width="17" Height="17" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M2,15 C5,13 5,9 8,8 M8,8 L14,2 L16,4 L10,10 Z" />
                    </ToggleButton>
                    <ToggleButton x:Name="HighlightTool" Style="{StaticResource ToolButton}" Click="OnToolClick" Tag="Highlight" ToolTip="Маркер (H)">
                        <Path Width="17" Height="17" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.7" StrokeLineJoin="Round" Data="M3,12 L11,4 L15,8 L7,16 L3,16 Z M10,5 L14,9" />
                    </ToggleButton>
                    <ToggleButton x:Name="TextTool" Style="{StaticResource ToolButton}" Click="OnToolClick" Tag="Text" ToolTip="Текст (T)">
                        <Path Width="17" Height="17" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M3,3 L14,3 M8.5,3 L8.5,15 M5.5,15 L11.5,15" />
                    </ToggleButton>
                    <ToggleButton x:Name="ConcealTool" Style="{StaticResource ToolButton}" Click="OnToolClick" Tag="Conceal" ToolTip="Скрыть область (B)">
                        <Path Width="17" Height="17" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M1.5,8.5 C5,3.5 12,3.5 15.5,8.5 C12,13.5 5,13.5 1.5,8.5 Z M3,15 L14,2" />
                    </ToggleButton>
                    <Separator Style="{StaticResource ToolbarSeparator}" />
                    <Button Style="{StaticResource BaseButton}" Click="OnUndoClick" ToolTip="Отменить (Ctrl+Z)">
                        <Path Width="17" Height="17" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M7,4 L2,8 L7,12 M3,8 L10,8 C14,8 15,11 15,14" />
                    </Button>
                    <Button Style="{StaticResource BaseButton}" Click="OnRedoClick" ToolTip="Повторить (Ctrl+Y)">
                        <Path Width="17" Height="17" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M10,4 L15,8 L10,12 M14,8 L7,8 C3,8 2,11 2,14" />
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ComboBox x:Name="TargetProfileBox" Width="216" SelectedIndex="3" ToolTip="Получатель"
                              ItemsSource="{Binding TargetProfiles}" DisplayMemberPath="DisplayName" SelectionChanged="OnTargetProfileChanged" />
                    <Button Margin="8,0,0,0" Style="{StaticResource BaseButton}" Click="OnSaveAsClick" ToolTip="Сохранить папку с PNG и Markdown" Content="Сохранить" />
                    <Button x:Name="PrepareButton" Margin="5,0,0,0" Style="{StaticResource PrimaryButton}" Click="OnPrepareClick" Content="Подготовить" IsEnabled="False" />
                    <Button x:Name="CopyButton" Margin="5,0,0,0" Style="{StaticResource BaseButton}" Click="OnCopyPackageClick" Content="Копировать" IsEnabled="False" ToolTip="PNG-файлы и текст в одном буфере" />
                    <Button x:Name="PasteButton" Margin="5,0,0,0" Style="{StaticResource BaseButton}" Click="OnPasteClick" Content="Вставить" IsEnabled="False" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="304" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#E8EBF0">
                <Grid>
                    <controls:AnnotationCanvas x:Name="EditorCanvas" Image="{Binding ActiveCapture.Image}" Annotations="{Binding ActiveCapture.Annotations}"
                                               Tool="{Binding CurrentTool}" AnnotationCreated="OnAnnotationCreated"
                                               SelectionChanged="OnCanvasSelectionChanged" AnnotationChanged="OnAnnotationChanged" />
                    <Border x:Name="EmptyState" Width="430" Padding="28" CornerRadius="12" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel>
                            <Border Width="54" Height="54" CornerRadius="12" Background="{StaticResource SelectedBrush}" HorizontalAlignment="Center">
                                <Path Width="25" Height="25" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.7" StrokeLineJoin="Round" Data="M3,7 L3,4 L8,4 L9.5,2 L16,2 L17.5,4 L22,4 L22,19 L3,19 Z M12.5,7 A4.5,4.5 0 1 0 12.5,16 A4.5,4.5 0 1 0 12.5,7" />
                            </Border>
                            <TextBlock Margin="0,17,0,5" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" Text="Сделайте первый снимок" />
                            <TextBlock Foreground="{StaticResource MutedInkBrush}" TextAlignment="Center" TextWrapping="Wrap" Text="Выделите область экрана, импортируйте файл или вставьте изображение из буфера." />
                            <StackPanel Margin="0,19,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource PrimaryButton}" Click="OnCaptureClick" Content="Сделать снимок" />
                                <Button Margin="7,0,0,0" Style="{StaticResource BaseButton}" Click="OnImportFileClick" Content="Выбрать файл" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
                <Grid Margin="16,15,16,12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,9">
                        <TextBlock Style="{StaticResource SectionLabel}" Text="КОММЕНТАРИЙ К СНИМКУ" />
                        <TextBlock x:Name="CaptureIdentity" DockPanel.Dock="Right" Margin="12,0,0,0" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Text="—" />
                    </DockPanel>
                    <TextBox x:Name="CaptureNoteBox" Grid.Row="1" MinHeight="78" MaxHeight="145" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Text="{Binding ActiveCapture.Note, UpdateSourceTrigger=PropertyChanged}" TextChanged="OnNoteTextChanged" ToolTip="Комментарий ко всему текущему снимку" />
                    <DockPanel Grid.Row="2" Margin="0,18,0,9">
                        <TextBlock Style="{StaticResource SectionLabel}" Text="ОТМЕТКИ" />
                        <TextBlock x:Name="AnnotationCount" DockPanel.Dock="Right" Margin="12,0,0,0" Foreground="{StaticResource MutedInkBrush}" Text="0" />
                    </DockPanel>
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="NotesList" ItemsSource="{Binding ActiveCapture.Annotations}" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="12,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="340" /></Grid.ColumnDefinitions>
                <ListBox x:Name="Filmstrip" Grid.Column="0" ItemsSource="{Binding Captures}" SelectedItem="{Binding ActiveCapture, Mode=TwoWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         Background="Transparent" BorderThickness="0" SelectionChanged="OnCaptureSelectionChanged"
                         PreviewMouseLeftButtonDown="OnFilmstripMouseDown" PreviewMouseMove="OnFilmstripMouseMove" Drop="OnFilmstripDrop" AllowDrop="True">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,8,0" /><Setter Property="Padding" Value="0" /><Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Background" Value="Transparent" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBorder" Width="126" Height="92" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource LineBrush}" Background="White">
                                        <Grid ClipToBounds="True">
                                            <Image Source="{Binding Image}" Stretch="UniformToFill" />
                                            <Border VerticalAlignment="Bottom" Height="25" Background="#DF172033">
                                                <DockPanel Margin="7,0">
                                                    <TextBlock VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold" Text="{Binding DisplayLabel}" />
                                                    <Button DockPanel.Dock="Right" Width="24" Height="22" Padding="5" Background="Transparent" BorderThickness="0" Click="OnDeleteCaptureClick" Tag="{Binding}" ToolTip="Удалить снимок">
                                                        <Path Stroke="White" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M2,2 L10,10 M10,2 L2,10" />
                                                    </Button>
                                                </DockPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" /><Setter TargetName="ItemBorder" Property="BorderThickness" Value="2" /></Trigger>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="BorderBrush" Value="#8095E8" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate></Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
                <Button Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Style="{StaticResource BaseButton}" Click="OnCaptureClick" ToolTip="Добавить ещё снимок">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="14" Height="14" Margin="0,0,6,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M7,1 L7,13 M1,7 L13,7" />
                        <TextBlock Text="Ещё снимок" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
                <Border Grid.Column="1" Padding="12,0,0,0" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" Margin="0,0,0,7" Text="ОБЩЕЕ ПОЖЕЛАНИЕ" />
                        <TextBox x:Name="OverallNoteBox" Height="67" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 TextChanged="OnNoteTextChanged" ToolTip="Комментарий ко всему пакету" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="#F8F9FB" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#728099" Margin="0,0,7,0" />
                    <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedInkBrush}" Text="Готов к работе" />
                </StackPanel>
                <TextBlock x:Name="PackageSummary" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedInkBrush}" Text="0 изображений · 0 заметок" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
