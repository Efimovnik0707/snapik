<Window x:Class="SnapBrief.App.OnboardingWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SnapBrief.App" xmlns:controls="clr-namespace:SnapBrief.App.Controls"
 Title="SnapBrief" Width="620" Height="600" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Foreground="#EEF2F8"
 WindowStartupLocation="CenterScreen" ShowInTaskbar="True" Topmost="True">
 <Window.Resources>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EEF2F8"/></Style>
  <!-- Step 1 is a choice between two cards, not a combo box: it is the first thing a new user sees. -->
  <Style x:Key="LanguageCard" TargetType="RadioButton">
   <Setter Property="Foreground" Value="#EEF2F8"/><Setter Property="Width" Value="250"/><Setter Property="Height" Value="104"/>
   <Setter Property="Margin" Value="0,0,14,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border x:Name="Card" Background="#252B35" BorderBrush="#445064" BorderThickness="1" CornerRadius="12">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#5C6879"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource FocusBrush}"/></Trigger>
     <Trigger Property="IsChecked" Value="True">
      <Setter TargetName="Card" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
      <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
     </Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Four phases of 1.2 s over simple shapes: the key is pressed, the area is selected, a note
       appears, the package goes into a chat. The captions under the drawing follow the same clock. -->
  <Storyboard x:Key="HintLoop" RepeatBehavior="Forever" Duration="0:0:4.8">
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HintKey" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.4"/><LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="1"/><DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="0.4"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HintKeyScale" Storyboard.TargetProperty="ScaleY">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/><LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="0.8"/><LinearDoubleKeyFrame KeyTime="0:0:0.5" Value="1"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HintSelection" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="1"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HintSelection" Storyboard.TargetProperty="Width">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:2.1" Value="150"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HintSelection" Storyboard.TargetProperty="Height">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:2.1" Value="66"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HintNote" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:2.4" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:2.9" Value="1"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HintPaste" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:3.6" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:4" Value="1"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HintArrow" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:3.7" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:4.1" Value="1"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HintChat" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.35"/><DiscreteDoubleKeyFrame KeyTime="0:0:3.6" Value="0.35"/><LinearDoubleKeyFrame KeyTime="0:0:4" Value="1"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HintCaption1" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/><DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="0"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HintCaption2" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="1"/><DiscreteDoubleKeyFrame KeyTime="0:0:2.4" Value="0"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HintCaption3" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:2.4" Value="1"/><DiscreteDoubleKeyFrame KeyTime="0:0:3.6" Value="0"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HintCaption4" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><DiscreteDoubleKeyFrame KeyTime="0:0:3.6" Value="1"/>
   </DoubleAnimationUsingKeyFrames>
  </Storyboard>
 </Window.Resources>
 <Border Background="#171B22" BorderBrush="#354052" BorderThickness="1" CornerRadius="16" Padding="24">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,18" Background="Transparent" MouseLeftButtonDown="OnHeaderDrag">
    <TextBlock Text="Знакомство со SnapBrief" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <Button x:Name="SkipButton" Style="{StaticResource BaseButton}" controls:ButtonChrome.HoverBackground="#2A3240" controls:ButtonChrome.PressedBackground="#20262F" HorizontalAlignment="Right" VerticalAlignment="Center" Width="28" Height="28" MinHeight="28" Padding="0" Click="OnSkip" ToolTip="Пропустить" AutomationProperties.Name="{local:UiText Пропустить}">
     <Path Data="M0,0 L11,11 M11,0 L0,11" Stroke="#EEF2F8" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
    </Button>
   </Grid>

   <Grid Grid.Row="1">
    <StackPanel x:Name="Step1">
     <TextBlock Text="Выберите язык" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
     <TextBlock Text="Интерфейс и подсказки будут на этом языке." Foreground="#8F9AAA" TextWrapping="Wrap" Margin="0,0,0,18"/>
     <StackPanel x:Name="LanguageRow" Orientation="Horizontal">
      <RadioButton x:Name="RussianCard" Style="{StaticResource LanguageCard}" GroupName="OnboardingLanguage" Content="Русский" FontSize="20"/>
      <RadioButton x:Name="EnglishCard" Style="{StaticResource LanguageCard}" GroupName="OnboardingLanguage" Content="English" FontSize="20"/>
     </StackPanel>
    </StackPanel>

    <StackPanel x:Name="Step2" Visibility="Collapsed">
     <TextBlock Text="Клавиша для снимка" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
     <TextBlock Text="Нажми на поле и введи своё сочетание" Foreground="#8F9AAA" TextWrapping="Wrap" Margin="0,0,0,18"/>
     <controls:HotkeyField x:Name="CaptureField" Width="360" HorizontalAlignment="Left"/>
    </StackPanel>

    <StackPanel x:Name="Step3" Visibility="Collapsed">
     <TextBlock Text="Запуск и панель задач" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14"/>
     <CheckBox x:Name="StartupBox" Content="{local:UiText Запускать с Windows}" Margin="0,0,0,22"/>
     <TextBlock Text="Чтобы лента всегда была под рукой, закрепи SnapBrief: открой Пуск, нажми правой кнопкой на SnapBrief и выбери «Закрепить на панели задач»" TextWrapping="Wrap" Margin="0,0,0,10"/>
     <TextBlock Text="Повторный запуск ярлыка не открывает второе окно, а показывает ленту." Foreground="#8F9AAA" TextWrapping="Wrap" Margin="0,0,0,14"/>
     <Button x:Name="ShortcutButton" Style="{StaticResource BaseButton}" controls:ButtonChrome.HoverBackground="#2A3240" controls:ButtonChrome.PressedBackground="#20262F" HorizontalAlignment="Left" Padding="0" Foreground="{DynamicResource AccentTextBrush}" Content="Показать ярлык" Click="OnShowShortcut"/>
    </StackPanel>

    <StackPanel x:Name="Step4" Visibility="Collapsed">
     <TextBlock Text="Как пользоваться" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
     <Border Background="#12161D" BorderBrush="#2A3240" BorderThickness="1" CornerRadius="12" Height="212">
      <Canvas x:Name="HintCanvas" Width="500" Height="200">
       <Border Canvas.Left="26" Canvas.Top="22" Width="230" Height="140" CornerRadius="8" Background="#1B212B" BorderBrush="#33404F" BorderThickness="1"/>
       <Rectangle Canvas.Left="42" Canvas.Top="40" Width="90" Height="8" RadiusX="4" RadiusY="4" Fill="#2C3746"/>
       <Rectangle Canvas.Left="42" Canvas.Top="56" Width="150" Height="8" RadiusX="4" RadiusY="4" Fill="#242E3B"/>
       <Rectangle x:Name="HintSelection" Canvas.Left="66" Canvas.Top="72" Width="0" Height="0" Opacity="0" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeDashArray="4 3"/>
       <Border x:Name="HintNote" Canvas.Left="120" Canvas.Top="146" Padding="8,4" CornerRadius="9" Opacity="0" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
        <StackPanel Orientation="Horizontal">
         <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0" Fill="{DynamicResource AccentBrush}"/>
         <Rectangle Width="46" Height="5" RadiusX="2" RadiusY="2" Fill="#8F9AAA" VerticalAlignment="Center"/>
        </StackPanel>
       </Border>
       <Border x:Name="HintKey" Canvas.Left="26" Canvas.Top="172" Padding="9,4" CornerRadius="6" Opacity="0.4" Background="#252C36" BorderBrush="#465366" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform><ScaleTransform x:Name="HintKeyScale"/></Border.RenderTransform>
        <TextBlock x:Name="HintKeyText" Text="Ctrl + Alt + S" FontSize="11" FontWeight="SemiBold" Foreground="#EEF2F8"/>
       </Border>
       <Path x:Name="HintArrow" Canvas.Left="266" Canvas.Top="80" Opacity="0" Data="M0,12 L48,12 M38,5 L48,12 L38,19" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
       <Border x:Name="HintPaste" Canvas.Left="286" Canvas.Top="34" Padding="9,4" CornerRadius="6" Opacity="0" Background="#252C36" BorderBrush="#465366" BorderThickness="1">
        <TextBlock Text="Ctrl + V" FontSize="11" FontWeight="SemiBold" Foreground="#EEF2F8"/>
       </Border>
       <Border x:Name="HintChat" Canvas.Left="330" Canvas.Top="70" Width="144" Height="58" CornerRadius="10" Opacity="0.35" Background="#1B212B" BorderBrush="#33404F" BorderThickness="1">
        <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
         <Rectangle Width="76" Height="6" RadiusX="3" RadiusY="3" Fill="#2C3746" HorizontalAlignment="Left" Margin="0,0,0,7"/>
         <Rectangle Width="106" Height="6" RadiusX="3" RadiusY="3" Fill="#242E3B" HorizontalAlignment="Left"/>
        </StackPanel>
       </Border>
      </Canvas>
     </Border>
     <Grid Height="24" Margin="0,14,0,0">
      <TextBlock x:Name="HintCaption1" Text="Нажми клавишу" FontSize="14" HorizontalAlignment="Center"/>
      <TextBlock x:Name="HintCaption2" Text="Выдели область" FontSize="14" HorizontalAlignment="Center" Opacity="0"/>
      <TextBlock x:Name="HintCaption3" Text="Добавь комментарии" FontSize="14" HorizontalAlignment="Center" Opacity="0"/>
      <TextBlock x:Name="HintCaption4" Text="Вставь в чат: Ctrl+V" FontSize="14" HorizontalAlignment="Center" Opacity="0"/>
     </Grid>
    </StackPanel>
   </Grid>

   <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="#FF9B95" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,8"/>
   <Grid Grid.Row="3" Margin="0,16,0,0">
    <TextBlock x:Name="StepText" Foreground="#8F9AAA" VerticalAlignment="Center"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
     <Button x:Name="BackButton" Style="{StaticResource BaseButton}" controls:ButtonChrome.HoverBackground="#2A3240" controls:ButtonChrome.PressedBackground="#20262F" Foreground="White" Margin="0,0,8,0" Content="Назад" Click="OnBack"/>
     <Button x:Name="NextButton" Style="{StaticResource PrimaryButton}" Content="Далее" Click="OnNext"/>
     <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Visibility="Collapsed" Content="Начать" Click="OnStart"/>
    </StackPanel>
   </Grid>
  </Grid>
 </Border>
</Window>
