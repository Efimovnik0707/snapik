<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- One of the seven palettes ThemeService swaps into the application resources. Every palette
         carries the same fourteen keys: a key missing from one of them would resolve under one
         theme and leave a DynamicResource unresolved under another. The chrome reads them through
         DynamicResource, so a swap repaints the open windows without rebuilding anything.
         Light: paper panels, ink text, the shadow barely there. -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#F5FFFFFF" />
    <SolidColorBrush x:Key="SurfaceBarBrush" Color="#F5F4F6F9" />
    <SolidColorBrush x:Key="SurfaceLineBrush" Color="#DDE2EA" />
    <SolidColorBrush x:Key="ElevatedBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ElevatedLineBrush" Color="#E3E7ED" />
    <SolidColorBrush x:Key="HoverBrush" Color="#E8ECF3" />
    <SolidColorBrush x:Key="PressedBrush" Color="#DDE3EE" />
    <SolidColorBrush x:Key="DividerBrush" Color="#1F000000" />
    <SolidColorBrush x:Key="TextBrush" Color="#172033" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#5E687A" />
    <SolidColorBrush x:Key="TextFaintBrush" Color="#8A93A3" />
    <Color x:Key="ShadowColor">#000000</Color>
    <sys:Double x:Key="ShadowOpacity">0.15</sys:Double>
    <SolidColorBrush x:Key="DangerBrush" Color="#B42318" />
</ResourceDictionary>
