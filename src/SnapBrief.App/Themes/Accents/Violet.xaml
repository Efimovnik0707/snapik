<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Accent "violet". Hover is the accent darkened by 12 %, pressed by 22 %, the light tone is the
         accent mixed with white and the soft one is the accent at 33 % over the surface below it.
         The four accents are placeholders until the palettes from the designer arrive; every accent
         dictionary must keep exactly these keys. -->
    <Color x:Key="AccentColor">#8B7CF6</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#7A6DD8" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#6C61C0" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#558B7CF6" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#B6ACF9" />
    <SolidColorBrush x:Key="FocusBrush" Color="#B6ACF9" />
</ResourceDictionary>
