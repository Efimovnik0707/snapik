<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Accent "teal". Hover is the accent darkened by 12 %, pressed by 22 %, the light tone is the
         accent mixed with white and the soft one is the accent at 33 % over the surface below it.
         The four accents are placeholders until the palettes from the designer arrive; every accent
         dictionary must keep exactly these keys. -->
    <Color x:Key="AccentColor">#2BB3A3</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#269E8F" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#228C7F" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#552BB3A3" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#79CFC5" />
    <SolidColorBrush x:Key="FocusBrush" Color="#79CFC5" />
</ResourceDictionary>
