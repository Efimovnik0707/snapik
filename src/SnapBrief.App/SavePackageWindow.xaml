<!-- Not themed this round: this window is on screen for seconds and its colours are written
     down here on purpose. The base Window style now paints by the palette of the theme, so
     the dark values are pinned here rather than inherited. -->
<Window x:Class="SnapBrief.App.SavePackageWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SnapBrief.App" xmlns:controls="clr-namespace:SnapBrief.App.Controls"
 Title="SnapBrief" Width="470" SizeToContent="Height" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Foreground="#EEF2F8"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <Window.Resources>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EEF2F8"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#252B35"/><Setter Property="Foreground" Value="#EEF2F8"/><Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="#445064"/><Setter Property="Padding" Value="10,7"/></Style>
 </Window.Resources>
 <Border Background="#171B22" BorderBrush="#354052" BorderThickness="1" CornerRadius="16" Padding="24">
  <StackPanel>
   <Grid Margin="0,0,0,20" Background="Transparent" MouseLeftButtonDown="OnHeaderDrag">
    <TextBlock Text="Сохранить пакет" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <!-- The cross is the cancel of this window, exactly as in the settings dialog. -->
    <Button Style="{StaticResource BaseButton}" controls:ButtonChrome.HoverBackground="#2A3240" controls:ButtonChrome.PressedBackground="#20262F" HorizontalAlignment="Right" VerticalAlignment="Center" Width="28" Height="28" MinHeight="28" Padding="0" Click="OnClose" ToolTip="Закрыть" AutomationProperties.Name="{local:UiText Закрыть}">
     <Path Data="M0,0 L11,11 M11,0 L0,11" Stroke="#EEF2F8" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
    </Button>
   </Grid>
   <TextBlock Text="Куда" Margin="0,0,0,7"/>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBox x:Name="DirectoryBox"/>
    <Button Grid.Column="1" Style="{StaticResource BaseButton}" controls:ButtonChrome.HoverBackground="#2A3240" controls:ButtonChrome.PressedBackground="#20262F" Foreground="White" Margin="6,0,0,0" Content="Обзор…" Click="OnBrowseDirectory"/>
   </Grid>
   <CheckBox x:Name="SubfolderBox" Content="Создать подпапку" Margin="0,16,0,0"/>
   <TextBlock x:Name="NameLabel" Text="Имя папки" Margin="0,14,0,7"/>
   <TextBox x:Name="NameBox"/>
   <TextBlock Text="В папку лягут снимки и prompt.md, текст с комментариями для ИИ" Foreground="#9AA6B6" TextWrapping="Wrap" Margin="0,14,0,0"/>
   <!-- The package takes the whole strip, sent captures included, and letters it in strip order,
        so a capture that was already sent can carry another letter here than in the strip. -->
   <TextBlock Text="Снимки в пакете нумеруются заново: A, B, C…" Foreground="#9AA6B6" TextWrapping="Wrap" Margin="0,6,0,0"/>
   <TextBlock x:Name="ErrorText" Foreground="#FF9B95" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,12,0,0"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
    <Button Style="{StaticResource BaseButton}" controls:ButtonChrome.HoverBackground="#2A3240" controls:ButtonChrome.PressedBackground="#20262F" Foreground="White" Margin="0,0,8,0" IsCancel="True" Content="Отмена"/>
    <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnSave" Content="Сохранить"/>
   </StackPanel>
  </StackPanel>
 </Border>
</Window>
