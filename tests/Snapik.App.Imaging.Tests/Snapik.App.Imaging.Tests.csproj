<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- The blur masks a region by the shape it was drawn with, and that shape lives in Core. -->
    <ProjectReference Include="..\..\src\Snapik.Core\Snapik.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\src\Snapik.App\Imaging\RegionBlur.cs" Link="Imaging\RegionBlur.cs" />
    <Compile Include="..\..\src\Snapik.App\Imaging\FrameCopy.cs" Link="Imaging\FrameCopy.cs" />
    <Compile Include="..\..\src\Snapik.App\Imaging\ShapeMask.cs" Link="Imaging\ShapeMask.cs" />
    <Compile Include="..\..\src\Snapik.App\Imaging\ColorConversion.cs" Link="Imaging\ColorConversion.cs" />
    <Compile Include="..\..\src\Snapik.App\Controls\ResizeGeometry.cs" Link="ResizeGeometry.cs" />
    <!-- How far a capture is scaled down to fit the screen, and how far it may be scrolled once it
         is shown at its own size: eleven places of the canvas count from what these decide. -->
    <Compile Include="..\..\src\Snapik.App\Controls\EditorGeometry.cs" Link="EditorGeometry.cs" />
    <Compile Include="..\..\src\Snapik.App\Controls\StripResizeGeometry.cs" Link="StripResizeGeometry.cs" />
    <Compile Include="..\..\src\Snapik.App\Controls\HotkeyLabelParts.cs" Link="HotkeyLabelParts.cs" />
    <Compile Include="..\..\src\Snapik.App\HotkeyRules.cs" Link="HotkeyRules.cs" />
    <Compile Include="..\..\src\Snapik.App\SingleInstanceActivation.cs" Link="SingleInstanceActivation.cs" />
    <Compile Include="..\..\src\Snapik.App\PublishedPackage.cs" Link="PublishedPackage.cs" />
    <Compile Include="..\..\src\Snapik.App\SoundThrottle.cs" Link="SoundThrottle.cs" />
    <Compile Include="..\..\src\Snapik.App\SaveNaming.cs" Link="SaveNaming.cs" />
    <Compile Include="..\..\src\Snapik.App\SettingsMigration.cs" Link="SettingsMigration.cs" />
    <Compile Include="..\..\src\Snapik.App\AppDataPaths.cs" Link="AppDataPaths.cs" />
    <!-- The box of a caption is measured here; the model of a mark comes along, because the measure
         is written back into the points of one. -->
    <Compile Include="..\..\src\Snapik.App\TextMarkMetrics.cs" Link="TextMarkMetrics.cs" />
    <Compile Include="..\..\src\Snapik.App\EditorModels.cs" Link="EditorModels.cs" />
  </ItemGroup>
</Project>
