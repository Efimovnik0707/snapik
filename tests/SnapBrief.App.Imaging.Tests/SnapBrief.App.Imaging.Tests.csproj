<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- The blur masks a region by the shape it was drawn with, and that shape lives in Core. -->
    <ProjectReference Include="..\..\src\SnapBrief.Core\SnapBrief.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\src\SnapBrief.App\Imaging\RegionBlur.cs" Link="Imaging\RegionBlur.cs" />
    <Compile Include="..\..\src\SnapBrief.App\Imaging\ShapeMask.cs" Link="Imaging\ShapeMask.cs" />
    <Compile Include="..\..\src\SnapBrief.App\Controls\ResizeGeometry.cs" Link="ResizeGeometry.cs" />
    <Compile Include="..\..\src\SnapBrief.App\Controls\StripResizeGeometry.cs" Link="StripResizeGeometry.cs" />
    <Compile Include="..\..\src\SnapBrief.App\Controls\HotkeyLabelParts.cs" Link="HotkeyLabelParts.cs" />
    <Compile Include="..\..\src\SnapBrief.App\HotkeyRules.cs" Link="HotkeyRules.cs" />
    <Compile Include="..\..\src\SnapBrief.App\SingleInstanceActivation.cs" Link="SingleInstanceActivation.cs" />
    <Compile Include="..\..\src\SnapBrief.App\PublishedPackage.cs" Link="PublishedPackage.cs" />
    <Compile Include="..\..\src\SnapBrief.App\SoundThrottle.cs" Link="SoundThrottle.cs" />
    <Compile Include="..\..\src\SnapBrief.App\SaveNaming.cs" Link="SaveNaming.cs" />
    <Compile Include="..\..\src\SnapBrief.App\SettingsMigration.cs" Link="SettingsMigration.cs" />
    <!-- The box of a caption is measured here; the model of a mark comes along, because the measure
         is written back into the points of one. -->
    <Compile Include="..\..\src\SnapBrief.App\TextMarkMetrics.cs" Link="TextMarkMetrics.cs" />
    <Compile Include="..\..\src\SnapBrief.App\EditorModels.cs" Link="EditorModels.cs" />
  </ItemGroup>
</Project>
